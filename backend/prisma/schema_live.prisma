  receiptId     String
  accountId     String
  paymentMethod String
  amount        Decimal   @db.Decimal(15, 2)
  referenceNo   String?
  chequeNo      String?
  transactionId String?
  clearanceDate DateTime?
  bankCharges   Decimal   @default(0) @db.Decimal(15, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  accounts      accounts  @relation(fields: [accountId], references: [id])
  receipts      receipts  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model receipts {
  id                  String                @id
  companyId           String
  receiptNo           String
  date                DateTime
  businessPartnerId   String
  accountId           String?
  amount              Decimal               @db.Decimal(12, 2)
  currency            String                @default("INR")
  exchangeRate        Decimal               @default(1.0) @db.Decimal(10, 4)
  receivedById        String
  status              String                @default("COMPLETED")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?
  receipt_allocations receipt_allocations[]
  receipt_attachments receipt_attachments[]
  receipt_audits      receipt_audits[]
  receipt_payments    receipt_payments[]
  accounts            accounts?             @relation(fields: [accountId], references: [id])
  business_partners   business_partners     @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  companies           companies             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users               users                 @relation(fields: [receivedById], references: [id])

  @@unique([companyId, receiptNo])
  @@index([companyId, date])
  @@index([companyId, deletedAt])
}

model recurring_invoice_items {
  id                 String             @id
  recurringInvoiceId String
  description        String
  qty                Decimal            @db.Decimal(15, 3)
  rate               Decimal            @db.Decimal(15, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  recurring_invoices recurring_invoices @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
}

model recurring_invoices {
  id                      String                    @id
  companyId               String
  businessPartnerId       String
  frequency               RecurringFrequency
  nextRunDate             DateTime
  status                  SubscriptionStatus        @default(ACTIVE)
  subTotal                Decimal                   @default(0) @db.Decimal(15, 2)
  taxTotal                Decimal                   @default(0) @db.Decimal(15, 2)
  grandTotal              Decimal                   @default(0) @db.Decimal(15, 2)
  createdAt               DateTime                  @default(now())
  createdBy               String?
  deletedAt               DateTime?
  updatedAt               DateTime
  updatedBy               String?
  recurring_invoice_items recurring_invoice_items[]
  business_partners       business_partners         @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  companies               companies                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([businessPartnerId])
  @@index([companyId])
}

model refund_transactions {
  id              String       @id
  companyId       String
  referenceId     String
  referenceType   String
  amount          Decimal      @db.Decimal(15, 2)
  refundMethod    RefundMethod @default(BANK_TRANSFER)
  transactionDate DateTime     @default(now())
  remarks         String?
  createdById     String
  companies       companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, referenceId])
}

model role_permissions {
  id       String @id
  roleId   String
  resource String
  action   String
  roles    roles  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
}

model roles {
  id               String             @id
  companyId        String?
  name             String
  description      String?
  isSystem         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  company_users    company_users[]
  employees        employees[]
  role_permissions role_permissions[]
  companies        companies?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model salary_components {
  id                         String                       @id
  companyId                  String
  code                       String
  name                       String
  type                       String
  description                String?
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  deletedAt                  DateTime?
  category                   String?
  employee_salary_components employee_salary_components[]
  companies                  companies                    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model salary_revisions {
  id                         String                       @id
  companyId                  String
  employeeId                 String
  effectiveDate              DateTime
  basicSalary                Decimal                      @db.Decimal(15, 2)
  status                     String                       @default("ACTIVE")
  notes                      String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  deletedAt                  DateTime?
  employee_salary_components employee_salary_components[]
  companies                  companies                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees                  employees                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
}

model salary_slips {
  id                  String               @id
  companyId           String
  employeeId          String
  basicSalary         Decimal              @db.Decimal(15, 2)
  allowances          Decimal              @db.Decimal(15, 2)
  bonus               Decimal              @default(0) @db.Decimal(15, 2)
  incentives          Decimal              @default(0) @db.Decimal(15, 2)
  advances            Decimal              @default(0) @db.Decimal(15, 2)
  deductions          Decimal              @default(0) @db.Decimal(15, 2)
  netSalary           Decimal              @db.Decimal(15, 2)
  generatedAt         DateTime             @default(now())
  absentDays          Float                @default(0)
  attendanceSummary   Json?
  deductionsBreakdown Json?
  earningsBreakdown   Json?
  paidDays            Float                @default(0)
  deletedAt           DateTime?
  endDate             DateTime             @default(now())
  payrollNumber       String?
  startDate           DateTime             @default(now())
  status              SalarySlipStatus     @default(DRAFT)
  payroll_audit_logs  payroll_audit_logs[]
  companies           companies            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees           employees            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, startDate, endDate])
}

model sales_order_items {
  id           String       @id
  orderId      String
  productId    String?
  description  String
  qty          Decimal      @db.Decimal(15, 3)
  rate         Decimal      @db.Decimal(15, 2)
  taxPercent   Decimal      @db.Decimal(5, 2)
  taxAmount    Decimal      @db.Decimal(15, 2)
  cgstAmount   Decimal      @default(0) @db.Decimal(15, 2)
  sgstAmount   Decimal      @default(0) @db.Decimal(15, 2)
  igstAmount   Decimal      @default(0) @db.Decimal(15, 2)
  cessAmount   Decimal      @default(0) @db.Decimal(15, 2)
  taxCategory  TaxCategory  @default(TAXABLE)
  total        Decimal      @db.Decimal(15, 2)
  sales_orders sales_orders @relation(fields: [orderId], references: [id], onDelete: Cascade)
  products     products?    @relation(fields: [productId], references: [id])
}

model sales_orders {
  id                 String              @id
  companyId          String
  businessPartnerId  String
  orderNo            String
  taxMode            TaxMode             @default(CGST_SGST)
  placeOfSupply      String?
  companyStateCode   String?
  customerStateCode  String?
  billingAddress     String?
  shippingAddress    String?
  date               DateTime
  status             DocumentStatus      @default(DRAFT)
  subTotal           Decimal             @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  cessAmount         Decimal             @default(0) @db.Decimal(15, 2)
  totalTaxAmount     Decimal             @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal             @default(0) @db.Decimal(15, 2)
  gstBreakup         Json?
  deletedAt          DateTime?
  commissionRecordId String?
  sales_order_items  sales_order_items[]
  business_partners  business_partners   @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  commission_records commission_records? @relation(fields: [commissionRecordId], references: [id])
  companies          companies           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, orderNo])
  @@index([companyId, businessPartnerId])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
}

model sales_return_items {
  id            String        @id
  salesReturnId String
  productId     String?
  description   String
  qty           Decimal       @db.Decimal(15, 3)
  rate          Decimal       @db.Decimal(15, 2)
  taxPercent    Decimal       @db.Decimal(5, 2)
  taxAmount     Decimal       @db.Decimal(15, 2)
  cgstAmount    Decimal       @default(0) @db.Decimal(15, 2)
  sgstAmount    Decimal       @default(0) @db.Decimal(15, 2)
  igstAmount    Decimal       @default(0) @db.Decimal(15, 2)
  cessAmount    Decimal       @default(0) @db.Decimal(15, 2)
  total         Decimal       @db.Decimal(15, 2)
  products      products?     @relation(fields: [productId], references: [id])
  sales_returns sales_returns @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([salesReturnId])
}

model sales_returns {
  id                 String               @id
  companyId          String
  businessPartnerId  String
  originalInvoiceId  String?
  returnNumber       String
  date               DateTime             @default(now())
  reason             String
  returnType         ReturnType           @default(CREDIT_NOTE)
  status             ReturnStatus         @default(DRAFT)
  subTotal           Decimal              @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal              @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  cessAmount         Decimal              @default(0) @db.Decimal(15, 2)
  totalTaxAmount     Decimal              @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal              @default(0) @db.Decimal(15, 2)
  remarks            String?
  createdById        String
  approvedById       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  sales_return_items sales_return_items[]
  business_partners  business_partners    @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  companies          companies            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices           invoices?            @relation(fields: [originalInvoiceId], references: [id])

  @@unique([companyId, returnNumber])
  @@index([companyId, businessPartnerId])
}

model scheduled_tasks {
  id          String     @id
  companyId   String
  type        String
  payload     Json
  status      TaskStatus @default(PENDING)
  runAt       DateTime
  completedAt DateTime?
  companies   companies  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model sessions {
  id         String    @id
  userId     String
  companyId  String?
  tokenHash  String    @unique
  userAgent  String?
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  isRevoked  Boolean   @default(false)
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model shifts {
  id        String      @id
  companyId String
  name      String
  startTime String
  endTime   String
  graceTime Int         @default(15)
  createdAt DateTime    @default(now())
  employees employees[]
  companies companies   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model staff_advances {
  id           String    @id
  companyId    String
  employeeId   String
  amount       Decimal   @db.Decimal(15, 2)
  paidDate     DateTime
  recoveryDate DateTime?
  status       String    @default("PENDING")
  notes        String?
  createdAt    DateTime  @default(now())
  companies    companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
}

model stock_ledgers {
  id             String            @id
  companyId      String
  productId      String
  type           StockMovementType
  quantityBefore Decimal           @default(0) @db.Decimal(15, 3)
  quantityChange Decimal           @db.Decimal(15, 3)
  quantityAfter  Decimal           @default(0) @db.Decimal(15, 3)
  averageCost    Decimal           @default(0) @db.Decimal(15, 2)
  referenceId    String?
  referenceType  String?
  notes          String?
  date           DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  companies      companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products       products          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([companyId, productId])
  @@index([referenceId])
}

model stocks {
  id                String      @id
  companyId         String
  productId         String
  quantity          Decimal     @default(0) @db.Decimal(15, 3)
  averageCost       Decimal     @default(0) @db.Decimal(15, 2)
  reservedQuantity  Decimal     @default(0) @db.Decimal(15, 3)
  availableQuantity Decimal     @default(0) @db.Decimal(15, 3)
  warehouseId       String?
  companies         companies   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products          products    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouses        warehouses? @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
}

model subscription_plans {
  id             String           @id
  name           String
  price          Decimal          @db.Decimal(10, 2)
  billingCycle   String
  maxUsers       Int              @default(1)
  maxInvoices    Int              @default(50)
  maxCustomers   Int              @default(50)
  feature_limits feature_limits[]
  subscriptions  subscriptions[]
}

model subscriptions {
  id                 String             @id
  companyId          String
  planId             String
  status             SubscriptionStatus
  startDate          DateTime
  endDate            DateTime?
  companies          companies          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription_plans subscription_plans @relation(fields: [planId], references: [id])

  @@index([companyId])
}

model support_tickets {
  id          String       @id
  companyId   String
  userId      String
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  companies   companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       users        @relation(fields: [userId], references: [id])

  @@index([companyId])
}

model system_settings {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime
}

model tax_override_logs {
  id              String    @id
  companyId       String
  userId          String
  documentId      String
  documentType    String
  previousTaxType String
  newTaxType      String
  previousState   String?
  newState        String?
  reason          String?
  ipAddress       String?
  createdAt       DateTime  @default(now())
  companies       companies @relation(fields: [companyId], references: [id])
  users           users     @relation(fields: [userId], references: [id])

  @@index([companyId])
}

model transaction_payments {
  id                  String                @id
  companyId           String
  businessPartnerId   String
  bankAccountId       String
  paymentNo           String
  paymentType         PaymentType           @default(INBOUND)
  date                DateTime
  amount              Decimal               @db.Decimal(15, 2)
  method              PaymentMethod         @default(BANK_TRANSFER)
  reference           String?
  notes               String?
  createdAt           DateTime              @default(now())
  deletedAt           DateTime?
  chequeNumber        String?
  payment_allocations payment_allocations[]
  bank_accounts       bank_accounts         @relation(fields: [bankAccountId], references: [id])
  business_partners   business_partners     @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  companies           companies             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, paymentNo])
  @@index([companyId, businessPartnerId])
  @@index([companyId, date])
  @@index([companyId, deletedAt])
}

model unit_conversions {
  id                                       String    @id
  companyId                                String
  fromUnitId                               String
  toUnitId                                 String
  multiplier                               Float
  description                              String?
  createdAt                                DateTime  @default(now())
  updatedAt                                DateTime
  companies                                companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  units_unit_conversions_fromUnitIdTounits units     @relation("unit_conversions_fromUnitIdTounits", fields: [fromUnitId], references: [id], onDelete: Cascade)
  units_unit_conversions_toUnitIdTounits   units     @relation("unit_conversions_toUnitIdTounits", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([companyId, fromUnitId, toUnitId])
}

model units {
  id                                                  String             @id
  companyId                                           String?
  name                                                String
  code                                                String
  isActive                                            Boolean            @default(true)
  createdAt                                           DateTime           @default(now())
  updatedAt                                           DateTime
  abbreviation                                        String?
  category                                            String             @default("Count")
  decimals                                            Int                @default(2)
  isSystem                                            Boolean            @default(false)
  keywords                                            String?
  symbol                                              String?
  unit_conversions_unit_conversions_fromUnitIdTounits unit_conversions[] @relation("unit_conversions_fromUnitIdTounits")
  unit_conversions_unit_conversions_toUnitIdTounits   unit_conversions[] @relation("unit_conversions_toUnitIdTounits")
  companies                                           companies?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model users {
  id                                                               String                   @id
  email                                                            String                   @unique
  name                                                             String
  passwordHash                                                     String
  globalRole                                                       UserRole                 @default(ACCOUNTANT)
  isActive                                                         Boolean                  @default(true)
  phone                                                            String?
  createdBy                                                        String?
  lastLogin                                                        DateTime?
  emailVerified                                                    Boolean                  @default(false)
  otpCode                                                          String?
  otpExpiresAt                                                     DateTime?
  failedLoginAttempts                                              Int                      @default(0)
  lockoutUntil                                                     DateTime?
  createdAt                                                        DateTime                 @default(now())
  updatedAt                                                        DateTime
  deletedAt                                                        DateTime?
  departmentId                                                     String?
  activity_feeds                                                   activity_feeds[]
  attendance_audit_logs                                            attendance_audit_logs[]
  attendance_corrections_attendance_corrections_approvedByTousers  attendance_corrections[] @relation("attendance_corrections_approvedByTousers")
  attendance_corrections_attendance_corrections_requestedByTousers attendance_corrections[] @relation("attendance_corrections_requestedByTousers")
  attendances_attendances_approvedByIdTousers                      attendances[]            @relation("attendances_approvedByIdTousers")
  attendances_attendances_lockedByIdTousers                        attendances[]            @relation("attendances_lockedByIdTousers")
  backup_audit_logs                                                backup_audit_logs[]
  backup_jobs                                                      backup_jobs[]
  backup_logs                                                      backup_logs[]
  backup_schedules                                                 backup_schedules[]
  company_users                                                    company_users[]
  employee_advances                                                employee_advances[]
  expense_attachments                                              expense_attachments[]
  expense_comments                                                 expense_comments[]
  expense_histories                                                expense_histories[]
  expenses                                                         expenses[]
  export_logs                                                      export_logs[]
  import_logs                                                      import_logs[]
  login_histories                                                  login_histories[]
  payroll_audit_logs                                               payroll_audit_logs[]
  platform_activity_logs                                           platform_activity_logs[]
  receipt_audits                                                   receipt_audits[]
  receipts                                                         receipts[]
  sessions                                                         sessions[]
  support_tickets                                                  support_tickets[]
  tax_override_logs                                                tax_override_logs[]
  departments                                                      departments?             @relation(fields: [departmentId], references: [id])
}

model warehouses {
  id                String              @id
  companyId         String
  name              String
  location          String?
  isActive          Boolean             @default(true)
  isDefault         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  inventory_batches inventory_batches[]
  inventory_serials inventory_serials[]
  stocks            stocks[]
  companies         companies           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model webhooks {
  id        String    @id
  companyId String
  url       String
  event     String
  isActive  Boolean   @default(true)
  secret    String?
  createdAt DateTime  @default(now())
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

