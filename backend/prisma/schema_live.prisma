generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                                                                       String               @id
  companyId                                                                String
  name                                                                     String
  code                                                                     String?
  isGroup                                                                  Boolean              @default(false)
  parentId                                                                 String?
  category                                                                 AccountCategory
  subCategory                                                              AccountSubCategory?
  balance                                                                  Decimal              @default(0) @db.Decimal(15, 2)
  balanceType                                                              AccountBalanceType   @default(DEBIT)
  nature                                                                   AccountNature        @default(DEBIT)
  companies                                                                companies            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts                                                                 accounts?            @relation("accountsToaccounts", fields: [parentId], references: [id])
  other_accounts                                                           accounts[]           @relation("accountsToaccounts")
  bank_accounts                                                            bank_accounts[]
  cash_accounts                                                            cash_accounts[]
  expense_categories_expense_categories_accountIdToaccounts                expense_categories[] @relation("expense_categories_accountIdToaccounts")
  expense_categories_expense_categories_defaultInputTaxAccountIdToaccounts expense_categories[] @relation("expense_categories_defaultInputTaxAccountIdToaccounts")
  income_categories                                                        income_categories[]
  journal_lines                                                            journal_lines[]
  receipt_payments                                                         receipt_payments[]
  receipts                                                                 receipts[]

  @@unique([companyId, name])
}

model activity_feeds {
  id          String    @id
  companyId   String
  userId      String?
  action      String
  entityType  String
  entityId    String
  description String?
  createdAt   DateTime  @default(now())
  companies   companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       users?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}

model api_keys {
  id        String    @id
  companyId String
  name      String
  key       String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model archive_logs {
  id              String     @id
  companyId       String
  module          String
  recordsArchived Int
  status          TaskStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  companies       companies  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model archive_rules {
  id            String    @id
  companyId     String
  module        String
  retentionDays Int
  isActive      Boolean   @default(true)
  companies     companies @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model attendance_audit_logs {
  id           String      @id
  attendanceId String
  userId       String?
  changedField String
  oldValue     String?
  newValue     String?
  reason       String?
  ipAddress    String?
  createdAt    DateTime    @default(now())
  attendances  attendances @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  users        users?      @relation(fields: [userId], references: [id])
}

model attendance_corrections {
  id                                              String      @id
  attendanceId                                    String
  employeeId                                      String
  requestedBy                                     String
  approvedBy                                      String?
  status                                          LeaveStatus @default(PENDING)
  reason                                          String
  requestedAt                                     DateTime    @default(now())
  resolvedAt                                      DateTime?
  users_attendance_corrections_approvedByTousers  users?      @relation("attendance_corrections_approvedByTousers", fields: [approvedBy], references: [id])
  attendances                                     attendances @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employees                                       employees   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  users_attendance_corrections_requestedByTousers users       @relation("attendance_corrections_requestedByTousers", fields: [requestedBy], references: [id])
}

model attendances {
  id                                    String                   @id
  companyId                             String
  employeeId                            String
  date                                  DateTime
  type                                  AttendanceType
  notes                                 String?
  breakTime                             Float?
  checkIn                               DateTime?
  checkOut                              DateTime?
  earlyExit                             Float?
  lateBy                                Float?
  overtime                              Float?
  workingHours                          Float?
  approvedAt                            DateTime?
  approvedById                          String?
  lockedAt                              DateTime?
  lockedById                            String?
  status                                AttendanceStatus         @default(DRAFT)
  attendance_audit_logs                 attendance_audit_logs[]
  attendance_corrections                attendance_corrections[]
  users_attendances_approvedByIdTousers users?                   @relation("attendances_approvedByIdTousers", fields: [approvedById], references: [id])
  companies                             companies                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees                             employees                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  users_attendances_lockedByIdTousers   users?                   @relation("attendances_lockedByIdTousers", fields: [lockedById], references: [id])

  @@unique([employeeId, date])
}

model audit_logs {
  id        String    @id
  companyId String
  userId    String
  action    String
  tableName String
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime  @default(now())
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model backup_audit_logs {
  id         String     @id
  companyId  String?
  userId     String
  action     String
  targetName String?
  ipAddress  String?
  userAgent  String?
  device     String?
  success    Boolean
  details    Json?
  createdAt  DateTime   @default(now())
  companies  companies? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users      users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model backup_jobs {
  id             String           @id
  companyId      String?
  createdById    String
  name           String
  operation      BackupOperation
  type           SystemBackupType
  status         JobStatus
  progress       Int              @default(0)
  sizeBytes      BigInt?
  durationMs     Int?
  checksum       String?
  fileUrl        String?
  encryptionMeta Json?
  errorLog       String?
  targetModules  Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  companies      companies?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users          users            @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([status])
}

model backup_logs {
  id        String     @id
  companyId String?
  userId    String?
  fileName  String
  fileSize  Int
  type      String     @default("MANUAL")
  level     String     @default("COMPANY")
  status    TaskStatus @default(PENDING)
  fileUrl   String?
  createdAt DateTime   @default(now())
  companies companies? @relation(fields: [companyId], references: [id])
  users     users?     @relation(fields: [userId], references: [id])

  @@index([companyId])
}

model backup_schedules {
  id             String            @id
  companyId      String?
  createdById    String
  frequency      ScheduleFrequency
  cronExpression String?
  retentionDays  Int               @default(30)
  lastRun        DateTime?
  nextRun        DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  companies      companies?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users          users             @relation(fields: [createdById], references: [id])

  @@index([companyId])
}

model bank_accounts {
  id                                                              String                 @id
  companyId                                                       String
  branchId                                                        String?
  name                                                            String
  accountName                                                     String?
  accountNumber                                                   String?
  ifsc                                                            String?
  upiId                                                           String?
  bankName                                                        String?
  accountType                                                     BankAccountType        @default(CURRENT)
  openingBalance                                                  Decimal                @default(0) @db.Decimal(15, 2)
  currentBalance                                                  Decimal                @default(0) @db.Decimal(15, 2)
  openingDate                                                     DateTime?
  lastReconciled                                                  DateTime?
  status                                                          String                 @default("ACTIVE")
  isDefault                                                       Boolean                @default(false)
  deletedAt                                                       DateTime?
  accountId                                                       String?
  accounts                                                        accounts?              @relation(fields: [accountId], references: [id])
  companies                                                       companies              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank_statements                                                 bank_statements[]
  bank_transactions                                               bank_transactions[]
  employee_advances                                               employee_advances[]
  expenses                                                        expenses[]
  internal_transfers_internal_transfers_fromBankIdTobank_accounts internal_transfers[]   @relation("internal_transfers_fromBankIdTobank_accounts")
  internal_transfers_internal_transfers_toBankIdTobank_accounts   internal_transfers[]   @relation("internal_transfers_toBankIdTobank_accounts")
  other_incomes                                                   other_incomes[]
  transaction_payments                                            transaction_payments[]

  @@index([companyId, deletedAt])
  @@index([companyId])
}

model bank_statement_lines {
  id                   String             @id
  statementId          String
  date                 DateTime
  description          String
  amount               Decimal            @db.Decimal(15, 2)
  status               String             @default("UNMATCHED")
  matchedTransactionId String?            @unique
  bank_transactions    bank_transactions? @relation(fields: [matchedTransactionId], references: [id])
  bank_statements      bank_statements    @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}

model bank_statements {
  id                   String                 @id
  companyId            String
  bankAccountId        String
  statementDate        DateTime
  openingBalance       Decimal                @default(0) @db.Decimal(15, 2)
  closingBalance       Decimal                @default(0) @db.Decimal(15, 2)
  status               String                 @default("DRAFT")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  bank_statement_lines bank_statement_lines[]
  bank_accounts        bank_accounts          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  companies            companies              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, bankAccountId])
}

model bank_transactions {
  id                   String                @id
  companyId            String
  bankAccountId        String
  date                 DateTime
  type                 String
  amount               Decimal               @db.Decimal(15, 2)
  balanceAfter         Decimal               @db.Decimal(15, 2)
  reference            String?
  description          String?
  isReconciled         Boolean               @default(false)
  createdAt            DateTime              @default(now())
  bank_statement_lines bank_statement_lines?
  bank_accounts        bank_accounts         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  companies            companies             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@index([companyId, date])
}

model bill_of_materials {
  id                String              @id
  companyId         String
  productId         String
  name              String
  totalCost         Decimal             @default(0) @db.Decimal(15, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  companies         companies           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products          products            @relation(fields: [productId], references: [id])
  bom_items         bom_items[]
  production_orders production_orders[]

  @@unique([companyId, productId])
}

model bom_items {
  id                String            @id
  bomId             String
  rawMaterialId     String
  qty               Decimal           @db.Decimal(15, 3)
  cost              Decimal           @db.Decimal(15, 2)
  bill_of_materials bill_of_materials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  products          products          @relation(fields: [rawMaterialId], references: [id])
}

model branches {
  id            String          @id
  companyId     String
  name          String
  code          String?
  address       String?
  phone         String?
  email         String?
  gstin         String?
  isActive      Boolean         @default(true)
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  companies     companies       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees     employees[]
  other_incomes other_incomes[]

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
  @@index([companyId])
}

model brands {
  id          String     @id
  companyId   String
  brandName   String
  brandCode   String
  description String?
  logoUrl     String?
  website     String?
  email       String?
  phone       String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  companies   companies  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    products[]

  @@unique([companyId, brandCode])
  @@unique([companyId, brandName])
  @@index([companyId, deletedAt])
  @@index([companyId])
}

model business_partners {
  id                    String                 @id
  companyId             String
  bpType                BusinessPartnerType
  bpCode                String
  name                  String
  tradeName             String?
  email                 String?
  phone                 String?
  whatsapp              String?
  gstin                 String?
  panNumber             String?
  address               String?
  pinCode               String?
  state                 String?
  stateCode             String?
  placeOfSupply         String?
  creditLimit           Decimal                @default(0) @db.Decimal(15, 2)
  receivableBalance     Decimal                @default(0) @db.Decimal(15, 2)
  payableBalance        Decimal                @default(0) @db.Decimal(15, 2)
  status                LeadStatus?
  source                String?
  leadValue             Decimal?               @db.Decimal(15, 2)
  notes                 String?
  portalAccessToken     String?                @unique
  tokenExpiresAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  customerDepartmentId  String?
  customerSegmentId     String?
  isMigrated            Boolean                @default(false)
  migrationNotes        String?
  migrationReferenceNo  String?
  openingBalanceAmount  Decimal                @default(0) @db.Decimal(15, 2)
  openingBalanceDate    DateTime?
  openingBalanceType    String                 @default("NONE")
  previousLedgerCode    String?
  previousSoftware      String?
  gstRegistrationStatus GSTRegistrationStatus? @default(UNREGISTERED)
  taxPreference         TaxPreference?         @default(TAXABLE)
  customerType          CustomerCategory?      @default(B2B)
  totalOverdue          Decimal                @default(0) @db.Decimal(15, 2)
  companies             companies              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer_departments  customer_departments?  @relation(fields: [customerDepartmentId], references: [id])
  customer_segments     customer_segments?     @relation(fields: [customerSegmentId], references: [id])
  commission_records    commission_records[]
  contacts              contacts[]
  crm_activities        crm_activities[]
  customer_statements   customer_statements[]
  delivery_notes        delivery_notes[]
  expenses              expenses[]
  goods_receipts        goods_receipts[]
  historical_invoices   historical_invoices[]
  invoices              invoices[]
  other_incomes         other_incomes[]
  projects              projects[]
  purchase_orders       purchase_orders[]
  purchase_returns      purchase_returns[]
  purchases             purchases[]
  quotations            quotations[]
  receipts              receipts[]
  recurring_invoices    recurring_invoices[]
  sales_orders          sales_orders[]
  sales_returns         sales_returns[]
  transaction_payments  transaction_payments[]

  @@index([bpType])
  @@index([companyId, deletedAt])
  @@index([companyId])
}

model cash_accounts {
  id                                                              String               @id
  companyId                                                       String
  branchId                                                        String?
  name                                                            String
  openingBalance                                                  Decimal              @default(0) @db.Decimal(15, 2)
  currentBalance                                                  Decimal              @default(0) @db.Decimal(15, 2)
  isDefault                                                       Boolean              @default(false)
  deletedAt                                                       DateTime?
  accountId                                                       String?
  accounts                                                        accounts?            @relation(fields: [accountId], references: [id])
  companies                                                       companies            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cash_transactions                                               cash_transactions[]
  employee_advances                                               employee_advances[]
  expenses                                                        expenses[]
  internal_transfers_internal_transfers_fromCashIdTocash_accounts internal_transfers[] @relation("internal_transfers_fromCashIdTocash_accounts")
  internal_transfers_internal_transfers_toCashIdTocash_accounts   internal_transfers[] @relation("internal_transfers_toCashIdTocash_accounts")

  @@index([companyId, deletedAt])
  @@index([companyId])
}

model cash_transactions {
  id            String        @id
  companyId     String
  cashAccountId String
  date          DateTime
  type          String
  amount        Decimal       @db.Decimal(15, 2)
  balanceAfter  Decimal       @db.Decimal(15, 2)
  reference     String?
  description   String?
  createdAt     DateTime      @default(now())
  cash_accounts cash_accounts @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  companies     companies     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([cashAccountId])
}

model commission_records {
  id                 String             @id
  companyId          String
  ruleId             String?
  referenceType      String
  referenceId        String
  referralSourceType ReferralSourceType
  employeeId         String?
  businessPartnerId  String?
  baseAmount         Decimal            @default(0) @db.Decimal(15, 2)
  commissionAmount   Decimal            @default(0) @db.Decimal(15, 2)
  tdsAmount          Decimal            @default(0) @db.Decimal(15, 2)
  netPayable         Decimal            @default(0) @db.Decimal(15, 2)
  status             CommissionStatus   @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  business_partners  business_partners? @relation(fields: [businessPartnerId], references: [id])
  companies          companies          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees          employees?         @relation(fields: [employeeId], references: [id])
  commission_rules   commission_rules?  @relation(fields: [ruleId], references: [id])
  invoices           invoices[]
  quotations         quotations[]
  sales_orders       sales_orders[]
}

model commission_rules {
  id                 String               @id
  companyId          String
  name               String
  referralSourceType ReferralSourceType
  commissionMethod   CommissionMethod
  commissionValue    Decimal              @db.Decimal(15, 2)
  tdsApplicable      Boolean              @default(false)
  tdsPercent         Decimal              @default(0) @db.Decimal(5, 2)
  expenseAccountId   String?
  payableAccountId   String?
  tdsAccountId       String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  commission_records commission_records[]
  companies          companies            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model companies {
  id                       String                     @id
  companyName              String
  legalName                String?
  gstin                    String?
  pan                      String?
  tan                      String?
  msme                     String?
  email                    String?
  phone                    String?
  address                  String?
  state                    String?
  country                  String?
  currency                 String                     @default("INR")
  logo                     String?
  status                   SubscriptionStatus         @default(FREE_TRIAL)
  onboardingStep           String                     @default("BUSINESS_DETAILS")
  businessType             BusinessType               @default(TRADING)
  trialStartAt             DateTime                   @default(now())
  trialEndAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  deletedAt                DateTime?
  pinCode                  String?
  tenantCode               String?                    @unique
  accounts                 accounts[]
  activity_feeds           activity_feeds[]
  api_keys                 api_keys[]
  archive_logs             archive_logs[]
  archive_rules            archive_rules[]
  attendances              attendances[]
  audit_logs               audit_logs[]
  backup_audit_logs        backup_audit_logs[]
  backup_jobs              backup_jobs[]
  backup_logs              backup_logs[]
  backup_schedules         backup_schedules[]
  bank_accounts            bank_accounts[]
  bank_statements          bank_statements[]
  bank_transactions        bank_transactions[]
  bill_of_materials        bill_of_materials[]
  branches                 branches[]
  brands                   brands[]
  business_partners        business_partners[]
  cash_accounts            cash_accounts[]
  cash_transactions        cash_transactions[]
  commission_records       commission_records[]
  commission_rules         commission_rules[]
  company_settings         company_settings?
  company_users            company_users[]
  contacts                 contacts[]
  cost_centers             cost_centers[]
  crm_activities           crm_activities[]
  customer_departments     customer_departments[]
  customer_segments        customer_segments[]
  customer_statements      customer_statements[]
  delivery_notes           delivery_notes[]
  departments              departments[]
  designations             designations[]
  document_sequences       document_sequences[]
  document_templates       document_templates[]
  employee_advances        employee_advances[]
  employee_loans           employee_loans[]
  employees                employees[]
  employment_types         employment_types[]
  expense_categories       expense_categories[]
  expenses                 expenses[]
  export_logs              export_logs[]
  feature_usages           feature_usages[]
  financial_years          financial_years[]
  fixed_assets             fixed_assets[]
  goods_receipts           goods_receipts[]
  gst_reports              gst_reports[]
  historical_invoices      historical_invoices[]
  holiday_calendars        holiday_calendars[]
  import_logs              import_logs[]
  income_categories        income_categories[]
  internal_transfers       internal_transfers[]
  inventory_batches        inventory_batches[]
  inventory_serials        inventory_serials[]
  invoices                 invoices[]
  journal_entries          journal_entries[]
  leave_applications       leave_applications[]
  leave_types              leave_types[]
  notification_preferences notification_preferences[]
  notifications            notifications[]
  other_incomes            other_incomes[]
  platform_activity_logs   platform_activity_logs[]
  platform_payments        platform_payments[]
  product_categories       product_categories[]
  production_orders        production_orders[]
  products                 products[]
  projects                 projects[]
  purchase_orders          purchase_orders[]
  purchase_returns         purchase_returns[]
  purchases                purchases[]
  quotations               quotations[]
  receipts                 receipts[]
  recurring_invoices       recurring_invoices[]
  refund_transactions      refund_transactions[]
  roles                    roles[]
  salary_components        salary_components[]
  salary_revisions         salary_revisions[]
  salary_slips             salary_slips[]
  sales_orders             sales_orders[]
  sales_returns            sales_returns[]
  scheduled_tasks          scheduled_tasks[]
  shifts                   shifts[]
  staff_advances           staff_advances[]
  stock_ledgers            stock_ledgers[]
  stocks                   stocks[]
  subscriptions            subscriptions[]
  support_tickets          support_tickets[]
  tax_override_logs        tax_override_logs[]
  transaction_payments     transaction_payments[]
  unit_conversions         unit_conversions[]
  units                    units[]
  warehouses               warehouses[]
  webhooks                 webhooks[]

  @@index([createdAt])
  @@index([status])
}

model company_settings {
  id                     String           @id
  companyId              String           @unique
  invoicePrefix          String           @default("INV")
  quotationPrefix        String           @default("QTN")
  creditNotePrefix       String           @default("CN")
  purchasePrefix         String           @default("PO")
  paymentPrefix          String           @default("PAY")
  defaultCurrency        String           @default("INR")
  termsAndConditions     String?
  bankDetails            String?
  emailSettings          Json?
  whatsappSettings       Json?
  gstSettings            Json?
  invoiceSettings        Json?
  currentFinancialYearId String?
  logoBase64             String?
  useLogoOnDocuments     Boolean          @default(true)
  activeModules          Json?
  defaultAccounts        Json?
  hrSettings             Json?
  payrollSettings        Json?
  companySealUrl         String?
  digitalSignatureUrl    String?
  invoiceConfig          Json?
  companies              companies        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financial_years        financial_years? @relation(fields: [currentFinancialYearId], references: [id])
}

model company_users {
  id           String    @id
  companyId    String
  userId       String
  role         UserRole
  customRoleId String?
  companies    companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles        roles?    @relation(fields: [customRoleId], references: [id])
  users        users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([customRoleId])
  @@index([userId])
}

model contacts {
  id                String            @id
  companyId         String
  businessPartnerId String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  createdAt         DateTime          @default(now())
