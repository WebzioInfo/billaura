  cashAccount   CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)

  @@index([cashAccountId])
  @@map("cash_transactions")
}

model InternalTransfer {
  id             String       @id @default(cuid())
  companyId      String
  transferNumber String
  date           DateTime
  amount         Decimal      @db.Decimal(15, 2)
  fromBankId     String?
  fromCashId     String?
  toBankId       String?
  toCashId       String?
  reference      String?
  description    String?      @db.Text
  createdAt      DateTime     @default(now())
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromBank       BankAccount? @relation("TransferFromBank", fields: [fromBankId], references: [id])
  toBank         BankAccount? @relation("TransferToBank", fields: [toBankId], references: [id])
  fromCash       CashAccount? @relation("TransferFromCash", fields: [fromCashId], references: [id])
  toCash         CashAccount? @relation("TransferToCash", fields: [toCashId], references: [id])

  @@unique([companyId, transferNumber])
  @@map("internal_transfers")
}

// --- ACCOUNTING SYSTEM ---
model Account {
  id               String              @id @default(cuid())
  companyId        String
  name             String
  code             String? // Ledger code
  isGroup          Boolean             @default(false)
  parentId         String?
  category         AccountCategory
  subCategory      AccountSubCategory?
  balance          Decimal             @default(0) @db.Decimal(15, 2)
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children         Account[]           @relation("AccountHierarchy")
  journalLines     JournalLine[]
  incomeCategories IncomeCategory[]
  receipts         Receipt[]

  @@unique([companyId, name])
  @@map("accounts")
}

model CostCenter {
  id           String        @id @default(cuid())
  companyId    String
  name         String
  code         String?
  description  String?       @db.Text
  parentId     String?
  isActive     Boolean       @default(true)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       CostCenter?   @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children     CostCenter[]  @relation("CostCenterHierarchy")
  journalLines JournalLine[]

  @@unique([companyId, name])
  @@map("cost_centers")
}

model JournalEntry {
  id          String        @id @default(cuid())
  companyId   String
  date        DateTime
  reference   String?
  description String?       @db.Text
  createdAt   DateTime      @default(now())
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines       JournalLine[]

  @@index([companyId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  costCenterId   String?
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_lines")
}

// --- SYSTEM LOGS & CONFIGS ---
