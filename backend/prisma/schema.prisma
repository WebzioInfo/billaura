generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- SAAS ENUMS ---
enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  CUSTOM_ROLE
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
}

enum SalaryType {
  MONTHLY
  DAILY_WAGE
  HOURLY
}

enum AttendanceType {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  FREE_TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

// --- BUSINESS ENUMS ---
enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  OPENING_STOCK
}

enum DocumentStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  ACCEPTED
  REJECTED
  CONVERTED
}

enum ReturnStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnType {
  REFUND
  REPLACEMENT
  CREDIT_NOTE
  DEBIT_NOTE
}

enum RefundMethod {
  CASH
  BANK_TRANSFER
  UPI
  FUTURE_ADJUSTMENT
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubCategory {
  SALES_REVENUE
  SERVICE_REVENUE
  SALES_RETURNS
  SALES_DISCOUNTS
  COGS
  OPERATING_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
  CURRENT_ASSET
  FIXED_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  UPI
  CHEQUE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CustomerType {
  REGISTERED
  UNREGISTERED
  COMPOSITION
  SEZ
  EXPORT
}

enum TaxMode {
  NO_TAX
  GST
  CGST_SGST
  IGST
  CESS
  TAX_INCLUSIVE
  TAX_EXCLUSIVE
  REVERSE_CHARGE
  ZERO_RATED
  EXEMPTED
  NIL_RATED
  NON_GST
}

enum InvoiceType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  RETAIL_INVOICE
  DEBIT_NOTE
  CREDIT_NOTE
  PROFORMA_INVOICE
  ESTIMATE
  DELIVERY_CHALLAN
  PURCHASE_INVOICE
  PURCHASE_RETURN
}

enum TaxCategory {
  TAXABLE
  EXEMPT
  NIL_RATED
  NON_GST
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  TASK
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum DocumentTemplateType {
  INVOICE
  QUOTATION
  PURCHASE
}

enum GSTReportType {
  GSTR_1
  GSTR_3B
  GSTR_9
}

enum GSTReportStatus {
  GENERATED
  FILED
}

enum SalarySlipStatus {
  GENERATED
  PAID
}

enum AdvanceStatus {
  PENDING
  RECOVERED
}

enum LoanStatus {
  ACTIVE
  CLOSED
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ValuationMethod {
  AVERAGE
  FIFO
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupLevel {
  RECORD
  MODULE
  COMPANY
  PLATFORM
}

enum BusinessPartnerType {
  CUSTOMER
  VENDOR
  LEAD
  CUSTOMER_VENDOR
}

// --- CORE SAAS MODELS ---
model Company {
  id             String             @id @default(cuid())
  companyName    String
  legalName      String?
  gstin          String?
  pan            String?
  email          String?
  phone          String?
  address        String?            @db.Text
  state          String?
  country        String?
  currency       String             @default("INR")
  logo           String?
  status         SubscriptionStatus @default(FREE_TRIAL)
  onboardingStep String             @default("BUSINESS_DETAILS")
  businessType   BusinessType       @default(TRADING)
  trialStartAt   DateTime           @default(now())
  trialEndAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  settings            CompanySettings?
  users               CompanyUser[]
  roles               Role[]
  departments         Department[]
  designations        Designation[]
  employees           Employee[]
  subscriptions       Subscription[]
  featureUsages       FeatureUsage[]
  businessPartners    BusinessPartner[]
  products            Product[]
  stocks              Stock[]
  stockLedgers        StockLedger[]
  invoices            Invoice[]
  recurringInvoices   RecurringInvoice[]
  quotations          Quotation[]
  purchases           Purchase[]
  transactionPayments TransactionPayment[]
  expenses            Expense[]
  expenseCategories   ExpenseCategory[]
  accounts            Account[]
  bankAccounts        BankAccount[]
  journalEntries      JournalEntry[]
  sequences           DocumentSequence[]
  auditLogs           AuditLog[]
  financialYears      FinancialYear[]
  documentTemplates   DocumentTemplate[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  activityFeeds       ActivityFeed[]
  supportTickets      SupportTicket[]
  scheduledTasks      ScheduledTask[]
  customerStatements  CustomerStatement[]
  gstReports          GSTReport[]
  platformPayments    PlatformPayment[]
  platformLogs        PlatformActivityLog[]    @relation("CompanyPlatformLogs")
  attendances         Attendance[]
  leaveApplications   LeaveApplication[]
  salarySlips         SalarySlip[]
  staffAdvances       StaffAdvance[]
  salesReturns        SalesReturn[]
  purchaseReturns     PurchaseReturn[]
  refundTransactions  RefundTransaction[]
  warehouses          Warehouse[]
  billOfMaterials     BillOfMaterial[]
  productionOrders    ProductionOrder[]
  shifts              Shift[]
  employeeLoans       EmployeeLoan[]
  salesOrders         SalesOrder[]
  importLogs          ImportLog[]
  exportLogs          ExportLog[]
  backupLogs          BackupLog[]
  archiveRules        ArchiveRule[]
  archiveLogs         ArchiveLog[]
  taxOverrideLogs     TaxOverrideLog[]
  branches            Branch[]

  contacts      Contact[]
  crmActivities CrmActivity[]
  units         Unit[]
  taxGroups     TaxGroup[]
  categories    Category[]
  brands        Brand[]

  @@index([status])
  @@index([createdAt])
  @@map("companies")
}

model Branch {
  id        String    @id @default(cuid())
  companyId String
  name      String
  code      String?
  address   String?   @db.Text
  phone     String?
  email     String?
  gstin     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

model CompanySettings {
  id                     String  @id @default(cuid())
  companyId              String  @unique
  invoicePrefix          String  @default("INV")
  quotationPrefix        String  @default("QTN")
  creditNotePrefix       String  @default("CN")
  purchasePrefix         String  @default("PO")
  paymentPrefix          String  @default("PAY")
  defaultCurrency        String  @default("INR")
  termsAndConditions     String? @db.Text
  bankDetails            String? @db.Text
  emailSettings          Json?
  whatsappSettings       Json?
  gstSettings            Json?
  invoiceSettings        Json?
  currentFinancialYearId String?
  logoBase64             String? @db.LongText
  useLogoOnDocuments     Boolean @default(true)
  activeModules          Json? // e.g. ["MANUFACTURING", "HRMS", "POS"]

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear FinancialYear? @relation(fields: [currentFinancialYearId], references: [id])

  @@map("company_settings")
}

model FinancialYear {
  id        String   @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isClosed  Boolean  @default(false)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settings CompanySettings[]

  @@unique([companyId, name])
  @@map("financial_years")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  globalRole          UserRole  @default(ACCOUNTANT)
  isActive            Boolean   @default(true)
  phone               String?
  department          String?
  createdBy           String?
  lastLogin           DateTime?
  emailVerified       Boolean   @default(false)
  otpCode             String?
  otpExpiresAt        DateTime?
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  companies           CompanyUser[]
  supportTickets      SupportTicket[]
  activityFeeds       ActivityFeed[]
  platformLogs        PlatformActivityLog[]
  approvedExpenses    Expense[]             @relation("ExpenseApprover")
  uploadedAttachments ExpenseAttachment[]   @relation("ExpenseUploader")
  importLogs          ImportLog[]
  exportLogs          ExportLog[]
  backupLogs          BackupLog[]
  taxOverrideLogs     TaxOverrideLog[]
  sessions            Session[]
  loginHistories      LoginHistory[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  companyId  String?
  tokenHash  String    @unique
  userAgent  String?
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  isRevoked  Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    String // SUCCESS, FAILED
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_histories")
}

model CompanyUser {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  role         UserRole
  customRoleId String?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole Role?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([customRoleId])
  @@map("company_users")
}

// --- RBAC MODULE ---
model Role {
  id          String   @id @default(cuid())
  companyId   String? // null for system/global roles
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       CompanyUser[]

  @@unique([companyId, name])
  @@map("roles")
}

model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  resource String
  action   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("role_permissions")
}

// --- SAAS OPS & SUBSCRIPTION ---
model SubscriptionPlan {
  id           String  @id @default(cuid())
  name         String
  price        Decimal @db.Decimal(10, 2)
  billingCycle String // MONTHLY, YEARLY
  maxUsers     Int     @default(1)
  maxInvoices  Int     @default(50)
  maxCustomers Int     @default(50)

  subscriptions Subscription[]
  limits        FeatureLimit[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String
  planId    String
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@map("subscriptions")
}

model FeatureLimit {
  id          String @id @default(cuid())
  planId      String
  featureName String
  limit       Int

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureName])
  @@map("feature_limits")
}

model FeatureUsage {
  id           String @id @default(cuid())
  companyId    String
  featureName  String
  currentUsage Int    @default(0)
  monthYear    String // e.g. "2026-06"

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureName, monthYear])
  @@map("feature_usages")
}

// --- SUPPORT & NOTIFICATIONS ---
model SupportTicket {
  id          String       @id @default(cuid())
  companyId   String
  userId      String
  subject     String
  description String       @db.Text
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("support_tickets")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  companyId String
  channel   String // EMAIL, WHATSAPP, SMS
  enabled   Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, channel])
  @@map("notification_preferences")
}

model ActivityFeed {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?
  action      String
  entityType  String
  entityId    String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("activity_feeds")
}

// --- CUSTOMER & VENDOR ---
model BusinessPartner {
  id        String              @id @default(cuid())
  companyId String
  bpType    BusinessPartnerType
  bpCode    String
  name      String
  tradeName String?
  email     String?
  phone     String?
  whatsapp  String?

  gstin        String?
  panNumber    String?
  customerType CustomerType? @default(UNREGISTERED)

  address       String? @db.Text
  pinCode       String?
  state         String?
  stateCode     String?
  placeOfSupply String?

  creditLimit       Decimal @default(0) @db.Decimal(15, 2)
  receivableBalance Decimal @default(0) @db.Decimal(15, 2)
  payableBalance    Decimal @default(0) @db.Decimal(15, 2)

  status    LeadStatus?
  source    String?
  leadValue Decimal?    @db.Decimal(15, 2)
  notes     String?     @db.Text

  portalAccessToken String?   @unique
  tokenExpiresAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  recurringInvoices   RecurringInvoice[]
  quotations          Quotation[]
  transactionPayments TransactionPayment[]
  statements          CustomerStatement[]
  salesReturns        SalesReturn[]
  salesOrders         SalesOrder[]
  purchases           Purchase[]
  purchaseReturns     PurchaseReturn[]
  contacts            Contact[]
  crmActivities       CrmActivity[]

  @@index([companyId])
  @@index([bpType])
  @@map("business_partners")
}

model CustomerStatement {
  id                String   @id @default(cuid())
  companyId         String
  businessPartnerId String
  date              DateTime
  type              String // INVOICE, PAYMENT
  reference         String
  debit             Decimal  @default(0) @db.Decimal(15, 2)
  credit            Decimal  @default(0) @db.Decimal(15, 2)
  balance           Decimal  @default(0) @db.Decimal(15, 2)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  @@index([companyId, businessPartnerId])
  @@map("customer_statements")
}

model Contact {
  id                String    @id @default(cuid())
  companyId         String
  businessPartnerId String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  designation       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([businessPartnerId])
  @@map("contacts")
}

model CrmActivity {
  id                String          @id @default(cuid())
  companyId         String
  businessPartnerId String
  type              CrmActivityType
  subject           String
  description       String?         @db.Text
  dueDate           DateTime?
  isCompleted       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([businessPartnerId])
  @@map("crm_activities")
}

// --- INVENTORY REDESIGN ---
model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@map("brands")
}

model Unit {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  abbreviation String
  decimals     Int      @default(2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, abbreviation])
  @@map("units")
}

model TaxGroup {
  id        String   @id @default(cuid())
  companyId String
  name      String
  totalRate Decimal  @db.Decimal(5, 2)
  cgstRate  Decimal  @default(0) @db.Decimal(5, 2)
  sgstRate  Decimal  @default(0) @db.Decimal(5, 2)
  igstRate  Decimal  @default(0) @db.Decimal(5, 2)
  cessRate  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@map("tax_groups")
}

model Product {
  id          String  @id @default(cuid())
  companyId   String
  categoryId  String?
  brandId     String?
  unitId      String?
  taxGroupId  String?
  sku         String?
  alias       String?
  barcode     String?
  name        String
  hsnCode     String?
  eInvoiceHsn String?
  scheduleNo  String?

  itemType   ItemType @default(FINISHED_GOOD)
  weight     Decimal? @db.Decimal(10, 3)
  weightType String? // kg, g, lb, etc. (mostly string label)

  taxRate     Decimal     @default(0) @db.Decimal(5, 2)
  gstRate     Decimal     @default(0) @db.Decimal(5, 2)
  taxType     String?
  taxCategory TaxCategory @default(TAXABLE)
  isExempt    Boolean     @default(false)
  isNilRated  Boolean     @default(false)
  isNonGst    Boolean     @default(false)

  purchasePrice Decimal @default(0) @db.Decimal(15, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(15, 2)

  minStock        Decimal @default(0) @db.Decimal(15, 3)
  maxStock        Decimal @default(0) @db.Decimal(15, 3)
  reorderLevel    Decimal @default(0) @db.Decimal(15, 3)
  pluNo           String?
  valuationMethod String  @default("AVERAGE") // AVERAGE, FIFO

  salesAccountId     String?
  purchaseAccountId  String?
  inventoryAccountId String?

  isActive Boolean @default(true)
  imageUrl String? @db.Text

  deletedAt DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category            Category?            @relation(fields: [categoryId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id])
  unit                Unit?                @relation(fields: [unitId], references: [id])
  taxGroup            TaxGroup?            @relation(fields: [taxGroupId], references: [id])
  stocks              Stock[]
  stockLedgers        StockLedger[]
  invoiceItems        InvoiceItem[]
  purchaseItems       PurchaseItem[]
  quotationItems      QuotationItem[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  billOfMaterials     BillOfMaterial[]
  bomItems            BOMItem[]

  @@index([companyId, sku])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Stock {
  id                String  @id @default(cuid())
  companyId         String
  productId         String
  quantity          Decimal @default(0) @db.Decimal(15, 3)
  averageCost       Decimal @default(0) @db.Decimal(15, 2)
  reservedQuantity  Decimal @default(0) @db.Decimal(15, 3)
  availableQuantity Decimal @default(0) @db.Decimal(15, 3)
  warehouseId       String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@map("stocks")
}

model StockLedger {
  id             String            @id @default(cuid())
  companyId      String
  productId      String
  type           StockMovementType
  quantityBefore Decimal           @default(0) @db.Decimal(15, 3)
  quantityChange Decimal           @db.Decimal(15, 3)
  quantityAfter  Decimal           @default(0) @db.Decimal(15, 3)
  averageCost    Decimal           @default(0) @db.Decimal(15, 2)
  referenceId    String?
  referenceType  String?
  notes          String?           @db.Text
  date           DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@index([referenceId])
  @@map("stock_ledgers")
}

// --- BILLING SYSTEM ---
model DocumentSequence {
  id            String @id @default(cuid())
  companyId     String
  documentType  String
  currentNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("document_sequences")
}

model Invoice {
  id                String      @id @default(cuid())
  companyId         String
  businessPartnerId String
  invoiceNo         String
  invoiceType       InvoiceType @default(TAX_INVOICE)
  taxMode           TaxMode     @default(CGST_SGST)
  placeOfSupply     String?
  companyStateCode  String?
  customerStateCode String?

  billingAddress  String? @db.Text
  shippingAddress String? @db.Text

  date           DateTime
  dueDate        DateTime?
  status         DocumentStatus @default(DRAFT)
  subTotal       Decimal        @default(0) @db.Decimal(15, 2)
  taxTotal       Decimal        @default(0) @db.Decimal(15, 2)
  cgstAmount     Decimal        @default(0) @db.Decimal(15, 2)
  sgstAmount     Decimal        @default(0) @db.Decimal(15, 2)
  igstAmount     Decimal        @default(0) @db.Decimal(15, 2)
  cessAmount     Decimal        @default(0) @db.Decimal(15, 2)
  totalTaxAmount Decimal        @default(0) @db.Decimal(15, 2)
  grandTotal     Decimal        @default(0) @db.Decimal(15, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(15, 2)

  gstBreakup Json?

  irn              String?
  qrCode           String? @db.Text
  eWayBillNumber   String?
  vehicleNumber    String?
  lrNumber         String?
  transportDetails Json?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner     @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  allocations     PaymentAllocation[]
  salesReturns    SalesReturn[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, businessPartnerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String      @id @default(cuid())
  invoiceId   String
  productId   String?
  description String      @db.Text
  qty         Decimal     @db.Decimal(15, 3)
  rate        Decimal     @db.Decimal(15, 2)
  taxPercent  Decimal     @db.Decimal(5, 2)
  taxAmount   Decimal     @db.Decimal(15, 2)
  cgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  sgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  igstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  cessAmount  Decimal     @default(0) @db.Decimal(15, 2)
  taxCategory TaxCategory @default(TAXABLE)
  total       Decimal     @db.Decimal(15, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model RecurringInvoice {
  id                String             @id @default(cuid())
  companyId         String
  businessPartnerId String
  frequency         RecurringFrequency // Using the enum added earlier
  nextRunDate       DateTime
  status            SubscriptionStatus @default(ACTIVE)
  subTotal          Decimal            @default(0) @db.Decimal(15, 2)
  taxTotal          Decimal            @default(0) @db.Decimal(15, 2)
  grandTotal        Decimal            @default(0) @db.Decimal(15, 2)

  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner        @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  items           RecurringInvoiceItem[]

  @@index([companyId])
  @@index([businessPartnerId])
  @@map("recurring_invoices")
}

model RecurringInvoiceItem {
  id                 String  @id @default(cuid())
  recurringInvoiceId String
  description        String  @db.Text
  qty                Decimal @db.Decimal(15, 3)
  rate               Decimal @db.Decimal(15, 2)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@map("recurring_invoice_items")
}

model Quotation {
  id                String  @id @default(cuid())
  companyId         String
  businessPartnerId String
  quotationNo       String
  taxMode           TaxMode @default(CGST_SGST)
  placeOfSupply     String?
  companyStateCode  String?
