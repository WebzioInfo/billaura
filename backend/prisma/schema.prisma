  companyId     String
  module        String
  retentionDays Int
  isActive      Boolean @default(true)
  company       Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("archive_rules")
}

model ArchiveLog {
  id              String     @id @default(cuid())
  companyId       String
  module          String
  recordsArchived Int
  status          TaskStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  company         Company    @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("archive_logs")
}

// --- PLATFORM ADMIN ---
model PlatformPayment {
  id           String   @id @default(cuid())
  companyId    String
  amount       Decimal  @db.Decimal(15, 2)
  method       String // CREDIT_CARD, BANK_TRANSFER, etc.
  status       String // SUCCESS, PENDING, FAILED
  reference    String?
  billingCycle String? // MONTHLY, YEARLY
  paymentDate  DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("platform_payments")
}

model PlatformActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  companyId   String?
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company     Company? @relation("CompanyPlatformLogs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("platform_activity_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model ApiKey {
  id        String    @id @default(cuid())
  companyId String
  name      String
  key       String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(cuid())
  companyId String
  url       String
  event     String // e.g. "invoice.created"
  isActive  Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("webhooks")
}

model DocumentTemplate {
  id          String  @id @default(cuid())
  companyId   String
  type        String // INVOICE, QUOTATION
  htmlContent String  @db.Text
  isDefault   Boolean @default(false)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("document_templates")
}

model GSTReport {
  id        String   @id @default(cuid())
  companyId String
  month     Int
  year      Int
  type      String // GSTR-1, GSTR-3B
  data      Json
  status    String // GENERATED, FILED
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year, type])
  @@map("gst_reports")
}

model ScheduledTask {
  id          String     @id @default(cuid())
  companyId   String
  type        String // RECURRING_INVOICE, REMINDER
  payload     Json
  status      TaskStatus @default(PENDING)
  runAt       DateTime
  completedAt DateTime?
