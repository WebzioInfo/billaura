generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  units               Unit[]
  historicalInvoices  HistoricalInvoice[]
  tenantCode          String?                  @unique
  employmentTypes     EmploymentType[]
  leaveTypes          LeaveType[]
  salaryComponents    SalaryComponent[]
  holidayCalendars    HolidayCalendar[]
  id                  String                   @id @default(cuid())
  companyName         String
  legalName           String?
  gstin               String?
  pan                 String?
  tan                 String?
  msme                String?
  email               String?
  phone               String?
  address             String?
  state               String?
  country             String?
  currency            String                   @default("INR")
  logo                String?
  status              SubscriptionStatus       @default(FREE_TRIAL)
  onboardingStep      String                   @default("BUSINESS_DETAILS")
  businessType        BusinessType             @default(TRADING)
  trialStartAt        DateTime                 @default(now())
  trialEndAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  pinCode             String?
  accounts            Account[]
  activityFeeds       ActivityFeed[]
  apiKeys             ApiKey[]
  archiveLogs         ArchiveLog[]
  archiveRules        ArchiveRule[]
  attendances         Attendance[]
  auditLogs           AuditLog[]
  backupAuditLogs     BackupAuditLog[]
  backupJobs          BackupJob[]
  backupLogs          BackupLog[]
  backupSchedules     BackupSchedule[]
  bankAccounts        BankAccount[]
  bankStatements      BankStatement[]
  bankTransactions    BankTransaction[]
  billOfMaterials     BillOfMaterial[]
  branches            Branch[]
  businessPartners    BusinessPartner[]
  cashAccounts        CashAccount[]
  cashTransactions    CashTransaction[]
  settings            CompanySettings?
  users               CompanyUser[]
  contacts            Contact[]
  costCenters         CostCenter[]
  crmActivities       CrmActivity[]
  customerStatements  CustomerStatement[]
  deliveryNotes       DeliveryNote[]
  sequences           DocumentSequence[]
  documentTemplates   DocumentTemplate[]
  advances            EmployeeAdvance[]
  employeeLoans       EmployeeLoan[]
  employees           Employee[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  exportLogs          ExportLog[]
  featureUsages       FeatureUsage[]
  financialYears      FinancialYear[]
  fixedAssets         FixedAsset[]
  goodsReceipts       GoodsReceipt[]
  gstReports          GSTReport[]
  importLogs          ImportLog[]
  incomeCategories    IncomeCategory[]
  internalTransfers   InternalTransfer[]
  inventoryBatches    InventoryBatch[]
  inventorySerials    InventorySerial[]
  invoices            Invoice[]
  journalEntries      JournalEntry[]
  leaveApplications   LeaveApplication[]
  notificationPrefs   NotificationPreference[]
  notifications       Notification[]
  otherIncomes        OtherIncome[]
  platformLogs        PlatformActivityLog[]    @relation("CompanyPlatformLogs")
  platformPayments    PlatformPayment[]
  productionOrders    ProductionOrder[]
  products            Product[]
  projects            Project[]
  purchaseOrders      PurchaseOrder[]
  purchaseReturns     PurchaseReturn[]
  purchases           Purchase[]
  quotations          Quotation[]
  receipts            Receipt[]
  recurringInvoices   RecurringInvoice[]
  refundTransactions  RefundTransaction[]
  roles               Role[]
  salarySlips         SalarySlip[]
  salesOrders         SalesOrder[]
  salesReturns        SalesReturn[]
  scheduledTasks      ScheduledTask[]
  shifts              Shift[]
  staffAdvances       StaffAdvance[]
  stockLedgers        StockLedger[]
  stocks              Stock[]
  subscriptions       Subscription[]
  supportTickets      SupportTicket[]
  taxOverrideLogs     TaxOverrideLog[]
  transactionPayments TransactionPayment[]
  warehouses          Warehouse[]
  webhooks            Webhook[]
  commissionRules     CommissionRule[]
  commissionRecords   CommissionRecord[]
  brands              Brand[]
  productCategories   ProductCategory[]
  customerSegments    CustomerSegment[]
  customerDepartments CustomerDepartment[]
  departments         Department[]
  designations        Designation[]
  unitConversions     UnitConversion[]

  @@index([status])
  @@index([createdAt])
  @@map("companies")
}

model Branch {
  id           String        @id @default(cuid())
  companyId    String
  name         String
  code         String?
  address      String?
  phone        String?
  email        String?
  gstin        String?
  isActive     Boolean       @default(true)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  otherIncomes OtherIncome[]
  employees    Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("branches")
}

model CompanySettings {
  id                     String         @id @default(cuid())
  companyId              String         @unique
  invoicePrefix          String         @default("INV")
  quotationPrefix        String         @default("QTN")
  creditNotePrefix       String         @default("CN")
  purchasePrefix         String         @default("PO")
  paymentPrefix          String         @default("PAY")
  defaultCurrency        String         @default("INR")
  termsAndConditions     String?
  bankDetails            String?
  emailSettings          Json?
  whatsappSettings       Json?
  gstSettings            Json?
  invoiceSettings        Json?
  defaultAccounts        Json?
  currentFinancialYearId String?
  logoBase64             String?
  useLogoOnDocuments     Boolean        @default(true)
  activeModules          Json?
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear          FinancialYear? @relation(fields: [currentFinancialYearId], references: [id])

  @@map("company_settings")
}

model FinancialYear {
  id        String            @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean           @default(false)
  isClosed  Boolean           @default(false)
  settings  CompanySettings[]
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("financial_years")
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  name                String
  passwordHash        String
  globalRole          UserRole              @default(ACCOUNTANT)
  isActive            Boolean               @default(true)
  phone               String?
  departmentId        String?
  department          Department?           @relation(fields: [departmentId], references: [id])
  createdBy           String?
  lastLogin           DateTime?
  emailVerified       Boolean               @default(false)
  otpCode             String?
  otpExpiresAt        DateTime?
  failedLoginAttempts Int                   @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  activityFeeds       ActivityFeed[]
  backupAuditLogs     BackupAuditLog[]
  backupJobs          BackupJob[]
  backupLogs          BackupLog[]
  backupSchedules     BackupSchedule[]
  companies           CompanyUser[]
  approvedAttendances  Attendance[]          @relation("AttendanceApprovedBy")
  lockedAttendances    Attendance[]          @relation("AttendanceLockedBy")
  attendanceAuditLogs  AttendanceAuditLog[]
  requestedCorrections AttendanceCorrection[] @relation("CorrectionRequester")
  approvedCorrections  AttendanceCorrection[] @relation("CorrectionApprover")
  approvedAdvances     EmployeeAdvance[]     @relation("AdvanceApprover")
  uploadedAttachments ExpenseAttachment[]   @relation("ExpenseUploader")
  expenseComments     ExpenseComment[]
  expenseHistories    ExpenseHistory[]
  approvedExpenses    Expense[]             @relation("ExpenseApprover")
  exportLogs          ExportLog[]
  importLogs          ImportLog[]
  loginHistories      LoginHistory[]
  platformLogs        PlatformActivityLog[]
  receiptAudits       ReceiptAudit[]
  receivedReceipts    Receipt[]
  sessions            Session[]
  supportTickets      SupportTicket[]
  taxOverrideLogs     TaxOverrideLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  companyId  String?
  tokenHash  String    @unique
  userAgent  String?
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  isRevoked  Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_histories")
}

model CompanyUser {
  id           String   @id @default(cuid())
  companyId    String
  userId       String
  role         UserRole
  customRoleId String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customRole   Role?    @relation(fields: [customRoleId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([customRoleId])
  @@map("company_users")
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       CompanyUser[]
  permissions RolePermission[]
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([companyId, name])
  @@map("roles")
}

model RolePermission {
  id       String @id @default(cuid())
  roleId   String
  resource String
  action   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("role_permissions")
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String
  price         Decimal        @db.Decimal(10, 2)
  billingCycle  String
  maxUsers      Int            @default(1)
  maxInvoices   Int            @default(50)
  maxCustomers  Int            @default(50)
  limits        FeatureLimit[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String
  planId    String
  status    SubscriptionStatus
  startDate DateTime
  endDate   DateTime?
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@map("subscriptions")
}

model FeatureLimit {
  id          String           @id @default(cuid())
  planId      String
  featureName String
  limit       Int
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureName])
  @@map("feature_limits")
}

model FeatureUsage {
  id           String  @id @default(cuid())
  companyId    String
  featureName  String
  currentUsage Int     @default(0)
  monthYear    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureName, monthYear])
  @@map("feature_usages")
}

model SupportTicket {
  id          String       @id @default(cuid())
  companyId   String
  userId      String
  subject     String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("support_tickets")
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  companyId String
  channel   String
  enabled   Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, channel])
  @@map("notification_preferences")
}

model ActivityFeed {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?
  action      String
  entityType  String
  entityId    String
  description String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("activity_feeds")
}

model CustomerSegment {
  id          String            @id @default(cuid())
  companyId   String
  name        String
  description String?
  segmentType String            @default("B2B")
  color       String?
  icon        String?
  isDefault   Boolean           @default(false)
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String?
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers   BusinessPartner[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("customer_segments")
}

model CustomerDepartment {
  id           String            @id @default(cuid())
  companyId    String
  name         String
  description  String?
  customerType String            @default("B2B")
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdBy    String?
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers    BusinessPartner[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("customer_departments")
}

model BusinessPartner {
  openingBalanceType    String                 @default("NONE")
  openingBalanceAmount  Decimal                @default(0) @db.Decimal(15, 2)
  openingBalanceDate    DateTime?
  migrationReferenceNo  String?
  migrationNotes        String?
  previousSoftware      String?
  previousLedgerCode    String?
  isMigrated            Boolean                @default(false)
  customerDepartmentId  String?
  id                    String                 @id @default(cuid())
  companyId             String
  bpType                BusinessPartnerType
  bpCode                String
  name                  String
  tradeName             String?
  email                 String?
  phone                 String?
  whatsapp              String?
  gstin                 String?
  panNumber             String?
  gstRegistrationStatus GSTRegistrationStatus? @default(UNREGISTERED)
  customerType          CustomerCategory?      @default(B2B)
  taxPreference         TaxPreference?         @default(TAXABLE)
  address               String?
  pinCode               String?
  state                 String?
  stateCode             String?
  placeOfSupply         String?
  creditLimit           Decimal                @default(0) @db.Decimal(15, 2)
  receivableBalance     Decimal                @default(0) @db.Decimal(15, 2)
  payableBalance        Decimal                @default(0) @db.Decimal(15, 2)
  status                LeadStatus?
  source                String?
  leadValue             Decimal?               @db.Decimal(15, 2)
  notes                 String?
  portalAccessToken     String?                @unique
  tokenExpiresAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  customerSegmentId     String?
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerSegment       CustomerSegment?       @relation(fields: [customerSegmentId], references: [id])
  customerDepartment    CustomerDepartment?    @relation(fields: [customerDepartmentId], references: [id])
  contacts              Contact[]
  crmActivities         CrmActivity[]
  statements            CustomerStatement[]
  deliveryNotes         DeliveryNote[]
  expenses              Expense[]
  goodsReceipts         GoodsReceipt[]
  invoices              Invoice[]
  otherIncomes          OtherIncome[]
  projects              Project[]
  purchaseOrders        PurchaseOrder[]
  purchaseReturns       PurchaseReturn[]
  purchases             Purchase[]
  quotations            Quotation[]
  receipts              Receipt[]
  recurringInvoices     RecurringInvoice[]
  salesOrders           SalesOrder[]
  salesReturns          SalesReturn[]
  transactionPayments   TransactionPayment[]
  commissionRecords     CommissionRecord[]
  historicalInvoices    HistoricalInvoice[]

  @@index([companyId])
  @@index([bpType])
  @@index([companyId, deletedAt])
  @@map("business_partners")
}

model CustomerStatement {
  id                String          @id @default(cuid())
  companyId         String
  businessPartnerId String
  date              DateTime
  type              String
  reference         String
  debit             Decimal         @default(0) @db.Decimal(15, 2)
  credit            Decimal         @default(0) @db.Decimal(15, 2)
  balance           Decimal         @default(0) @db.Decimal(15, 2)
  businessPartner   BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, businessPartnerId])
  @@map("customer_statements")
}

model Contact {
  id                String          @id @default(cuid())
  companyId         String
  businessPartnerId String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  designationId     String?
  designation       Designation?    @relation(fields: [designationId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  businessPartner   BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([businessPartnerId])
  @@index([companyId, deletedAt])
  @@map("contacts")
}

model CrmActivity {
  id                String          @id @default(cuid())
  companyId         String
  businessPartnerId String
  type              CrmActivityType
  subject           String
  description       String?
  dueDate           DateTime?
  isCompleted       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  businessPartner   BusinessPartner @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([businessPartnerId])
  @@map("crm_activities")
}

enum TaxPreference {
  TAXABLE
  EXEMPT
  NIL_RATED
  NON_GST
  COMPOSITION
  REVERSE_CHARGE
}

model Product {
  id                  String               @id @default(cuid())
  companyId           String
  categoryId          String?
  brandId             String?
  unit                String               @default("PCS")
  sku                 String?
  alias               String?
  barcode             String?
  name                String
  hsnCode             String?
  eInvoiceHsn         String?
  scheduleNo          String?
  itemType            ItemType             @default(FINISHED_GOOD)
  weight              Decimal?             @db.Decimal(10, 3)
  weightType          String?
  gstRate             Decimal              @default(0) @db.Decimal(5, 2)
  taxPreference       TaxPreference        @default(TAXABLE)
  purchasePrice       Decimal              @default(0) @db.Decimal(15, 2)
  sellingPrice        Decimal              @default(0) @db.Decimal(15, 2)
  minStock            Decimal              @default(0) @db.Decimal(15, 3)
  maxStock            Decimal              @default(0) @db.Decimal(15, 3)
  reorderLevel        Decimal              @default(0) @db.Decimal(15, 3)
  pluNo               String?
  valuationMethod     String               @default("AVERAGE")
  salesAccountId      String?
  purchaseAccountId   String?
  inventoryAccountId  String?
  isPurchasable       Boolean              @default(true)
  isSellable          Boolean              @default(true)
  isInventoryItem     Boolean              @default(true)
  isTaxable           Boolean              @default(true)
  isTrackStock        Boolean              @default(true)
  isTrackBatch        Boolean              @default(false)
  isTrackSerial       Boolean              @default(false)
  isManufactured      Boolean              @default(false)
  isService           Boolean              @default(false)
  isDigital           Boolean              @default(false)
  isAsset             Boolean              @default(false)
  isExpense           Boolean              @default(false)
  isActive            Boolean              @default(true)
  imageUrl            String?
  deletedAt           DateTime?
  billOfMaterials     BillOfMaterial[]
  bomItems            BOMItem[]
  deliveryNoteItems   DeliveryNoteItem[]
  goodsReceiptItems   GoodsReceiptItem[]
  batches             InventoryBatch[]
  serials             InventorySerial[]
  invoiceItems        InvoiceItem[]
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category            ProductCategory?     @relation(fields: [categoryId], references: [id])
  brand               Brand?               @relation(fields: [brandId], references: [id])
  purchaseItems       PurchaseItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseReturnItems PurchaseReturnItem[]
  quotationItems      QuotationItem[]
  salesOrderItems     SalesOrderItem[]
  salesReturnItems    SalesReturnItem[]
  stockLedgers        StockLedger[]
  stocks              Stock[]

  @@index([companyId, sku])
  @@index([companyId, deletedAt])
  @@map("products")
}

model Stock {
  id                String     @id @default(cuid())
  companyId         String
  productId         String
  quantity          Decimal    @default(0) @db.Decimal(15, 3)
  averageCost       Decimal    @default(0) @db.Decimal(15, 2)
  reservedQuantity  Decimal    @default(0) @db.Decimal(15, 3)
  availableQuantity Decimal    @default(0) @db.Decimal(15, 3)
  warehouseId       String?
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([companyId, productId, warehouseId])
  @@map("stocks")
}

model StockLedger {
  id             String            @id @default(cuid())
  companyId      String
  productId      String
  type           StockMovementType
  quantityBefore Decimal           @default(0) @db.Decimal(15, 3)
  quantityChange Decimal           @db.Decimal(15, 3)
  quantityAfter  Decimal           @default(0) @db.Decimal(15, 3)
  averageCost    Decimal           @default(0) @db.Decimal(15, 2)
  referenceId    String?
  referenceType  String?
  notes          String?
  date           DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@index([referenceId])
  @@index([companyId, date])
  @@map("stock_ledgers")
}

model DocumentSequence {
  id              String       @id @default(cuid())
  companyId       String
  documentType    String
  currentNumber   Int          @default(0)
  prefix          String?
  suffix          String?
  padding         Int          @default(6)
  sequenceType    SequenceType @default(SEQUENTIAL)
  resetLogic      String       @default("NEVER") // NEVER, YEARLY, MONTHLY
  lastGeneratedAt DateTime     @default(now())
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("document_sequences")
}

model Invoice {
  id                 String              @id @default(cuid())
  companyId          String
  businessPartnerId  String
  invoiceNo          String
  invoiceType        InvoiceType         @default(TAX_INVOICE)
  taxMode            TaxMode             @default(CGST_SGST)
  placeOfSupply      String?
  companyStateCode   String?
  customerStateCode  String?
  billingAddress     String?
  shippingAddress    String?
  date               DateTime
  dueDate            DateTime?
  status             DocumentStatus      @default(DRAFT)
  subTotal           Decimal             @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal             @default(0) @db.Decimal(15, 2)
  cessAmount         Decimal             @default(0) @db.Decimal(15, 2)
  totalTaxAmount     Decimal             @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal             @default(0) @db.Decimal(15, 2)
  amountPaid         Decimal             @default(0) @db.Decimal(15, 2)
  isRcm              Boolean             @default(false)
  tdsAmount          Decimal             @default(0) @db.Decimal(15, 2)
  tcsAmount          Decimal             @default(0) @db.Decimal(15, 2)
  gstBreakup         Json?
  irn                String?
  qrCode             String?
  eWayBillNumber     String?
  vehicleNumber      String?
  lrNumber           String?
  transportDetails   Json?
  createdAt          DateTime            @default(now())
  deletedAt          DateTime?
  commissionRecordId String?
