model QuotationItem {
  id          String      @id @default(cuid())
  quotationId String
  productId   String?
  description String      @db.Text
  qty         Decimal     @db.Decimal(15, 3)
  rate        Decimal     @db.Decimal(15, 2)
  taxPercent  Decimal     @db.Decimal(5, 2)
  taxAmount   Decimal     @db.Decimal(15, 2)
  cgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  sgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  igstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  cessAmount  Decimal     @default(0) @db.Decimal(15, 2)
  taxCategory TaxCategory @default(TAXABLE)
