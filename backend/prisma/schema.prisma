model PurchaseItem {
  id          String      @id @default(cuid())
  purchaseId  String
  productId   String?
  description String      @db.Text
  qty         Decimal     @db.Decimal(15, 3)
  rate        Decimal     @db.Decimal(15, 2)
  taxPercent  Decimal     @db.Decimal(5, 2)
  taxAmount   Decimal     @db.Decimal(15, 2)
  cgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  sgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  igstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  cessAmount  Decimal     @default(0) @db.Decimal(15, 2)
  taxCategory TaxCategory @default(TAXABLE)
  total       Decimal     @db.Decimal(15, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@map("purchase_items")
}

// --- PAYMENT MODULE ---
model TransactionPayment {
  id                String        @id @default(cuid())
  companyId         String
  businessPartnerId String
  bankAccountId     String
  paymentNo         String
  paymentType       PaymentType   @default(INBOUND)
  date              DateTime
  amount            Decimal       @db.Decimal(15, 2)
  method            PaymentMethod @default(BANK_TRANSFER)
  reference         String?
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  deletedAt         DateTime?

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner     @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id])
  allocations     PaymentAllocation[]

  @@unique([companyId, paymentNo])
  @@index([companyId, businessPartnerId])
  @@map("transaction_payments")
}

model PaymentAllocation {
  id                   String  @id @default(cuid())
  transactionPaymentId String
  invoiceId            String?
  purchaseId           String?
  amount               Decimal @db.Decimal(15, 2)

  transactionPayment TransactionPayment @relation(fields: [transactionPaymentId], references: [id], onDelete: Cascade)
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchase           Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([transactionPaymentId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@map("payment_allocations")
}

// --- EXPENSE MODULE ---
model ExpenseCategory {
  id          String   @id @default(cuid())
  companyId   String? // null for default system categories
  name        String
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
  @@map("expense_categories")
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  branchId      String?
  categoryId    String
  subCategory   String?
  bankAccountId String?
  expenseNo     String
  billNumber    String?
  date          DateTime

  amount      Decimal @db.Decimal(15, 2)
  taxAmount   Decimal @default(0) @db.Decimal(15, 2)
  totalAmount Decimal @db.Decimal(15, 2)

  paymentMethod PaymentMethod?
  status        ExpenseStatus  @default(DRAFT)

  reference   String?
  notes       String? @db.Text
  description String? @db.Text

  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory     @relation(fields: [categoryId], references: [id])
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id])
  approvedBy  User?               @relation("ExpenseApprover", fields: [approvedById], references: [id])
  attachments ExpenseAttachment[]

  @@unique([companyId, expenseNo])
  @@index([companyId, categoryId])
  @@index([approvedById])
  @@map("expenses")
}

model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  fileUrl      String   @db.Text
  thumbnailUrl String?  @db.Text
  fileType     String
  fileName     String
  uploadedById String
  uploadDate   DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ExpenseUploader", fields: [uploadedById], references: [id])

  @@index([expenseId])
  @@index([uploadedById])
  @@map("expense_attachments")
}

// --- BANKING ---
model BankAccount {
  id             String    @id @default(cuid())
  companyId      String
  name           String // Cash, HDFC, ICICI
  accountNumber  String?
  ifsc           String?
  bankName       String?
  openingBalance Decimal   @default(0) @db.Decimal(15, 2)
  currentBalance Decimal   @default(0) @db.Decimal(15, 2)
  isDefault      Boolean   @default(false)
  deletedAt      DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionPayments TransactionPayment[]
  expenses            Expense[]

  @@index([companyId])
  @@map("bank_accounts")
}

// --- ACCOUNTING SYSTEM ---
model Account {
  id          String              @id @default(cuid())
  companyId   String
  name        String
  category    AccountCategory
  subCategory AccountSubCategory?
  balance     Decimal             @default(0) @db.Decimal(15, 2)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, name])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  reference   String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@index([companyId, date])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// --- SYSTEM LOGS & CONFIGS ---
model AuditLog {
