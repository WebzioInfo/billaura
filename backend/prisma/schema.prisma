  companyId    String
  amount       Decimal  @db.Decimal(15, 2)
  method       String // CREDIT_CARD, BANK_TRANSFER, etc.
  status       String // SUCCESS, PENDING, FAILED
  reference    String?
  billingCycle String? // MONTHLY, YEARLY
