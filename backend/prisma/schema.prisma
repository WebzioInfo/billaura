  newTaxType      String
  previousState   String?
  newState        String?
  reason          String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("tax_override_logs")
}

model ExportLog {
  id        String     @id @default(cuid())
  companyId String?
  userId    String
  module    String
  format    String
  status    TaskStatus @default(PENDING)
  fileUrl   String?
  fileSize  Int?
  ipAddress String?
  createdAt DateTime   @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("export_logs")
}

model ArchiveRule {
  id            String  @id @default(cuid())
  companyId     String
  module        String
  retentionDays Int
  isActive      Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("archive_rules")
}

model ArchiveLog {
  id              String     @id @default(cuid())
  companyId       String
  module          String
  recordsArchived Int
  status          TaskStatus @default(PENDING)
  createdAt       DateTime   @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("archive_logs")
}

// --- PLATFORM ADMIN ---
model PlatformPayment {
