model CommissionRule {
  id                 String             @id @default(cuid())
  companyId          String
  name               String
  referralSourceType ReferralSourceType
  commissionMethod   CommissionMethod
  commissionValue    Decimal            @db.Decimal(15, 2)
  tdsApplicable      Boolean            @default(false)
  tdsPercent         Decimal            @default(0) @db.Decimal(5, 2)
  expenseAccountId   String?
  payableAccountId   String?
  tdsAccountId       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  records CommissionRecord[]
  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("commission_rules")
}

model CommissionRecord {
  id                 String             @id @default(cuid())
  companyId          String
  ruleId             String?
  referenceType      String
  referenceId        String
  referralSourceType ReferralSourceType
  employeeId         String?
  businessPartnerId  String?
  baseAmount         Decimal            @default(0) @db.Decimal(15, 2)
  commissionAmount   Decimal            @default(0) @db.Decimal(15, 2)
  tdsAmount          Decimal            @default(0) @db.Decimal(15, 2)
  netPayable         Decimal            @default(0) @db.Decimal(15, 2)
  status             CommissionStatus   @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule            CommissionRule?  @relation(fields: [ruleId], references: [id])
  employee        Employee?        @relation(fields: [employeeId], references: [id])
  businessPartner BusinessPartner? @relation(fields: [businessPartnerId], references: [id])

  invoices    Invoice[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@map("commission_records")
}

