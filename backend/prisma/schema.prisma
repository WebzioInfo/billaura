// --- PAYROLL MODULE ---
// Removed Department and Designation tables - converted to scalar strings
model Employee {
  id                 String             @id @default(cuid())
  companyId          String
  employeeCode       String
  name               String
  photo              String?            @db.Text
  mobile             String?
  email              String?
  address            String?            @db.Text
  dateOfBirth        DateTime?
  gender             String?
  joiningDate        DateTime?
  department         String?
  designation        String?
  shiftId            String?
  employeeType       String             @default("PERMANENT")
  salaryType         SalaryType         @default(MONTHLY)
  basicSalary        Decimal            @default(0) @db.Decimal(15, 2)
  allowances         Json? // Store structured JSON array of { name, amount }
  bankDetails        Json? // Store { accountName, accountNumber, ifsc, bankName }
  aadhaarNumber      String?
  panNumber          String?
  status             String             @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED, TERMINATED
  reportingManagerId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportingManager   Employee?          @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  reportees          Employee[]         @relation("ReportingManager")
  shift              Shift?             @relation(fields: [shiftId], references: [id])
  attendances        Attendance[]
  leaveApplications  LeaveApplication[]
  salarySlips        SalarySlip[]
  advances           StaffAdvance[]
  loans              EmployeeLoan[]
  otherIncomes       OtherIncome[]
  expenses           Expense[]
  employeeAdvances   EmployeeAdvance[]

  @@unique([companyId, employeeCode])
  @@index([companyId, deletedAt])
  @@map("employees")
}

model Attendance {
  id         String         @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime
  type       AttendanceType
  notes      String?
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model LeaveApplication {
  id         String      @id @default(cuid())
  companyId  String
  employeeId String
  type       String // CASUAL, SICK, PAID, EMERGENCY
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  reason     String?     @db.Text
  approvedBy String?
  createdAt  DateTime    @default(now())
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("leave_applications")
}

model SalarySlip {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal  @db.Decimal(15, 2)
  allowances  Decimal  @db.Decimal(15, 2)
  bonus       Decimal  @default(0) @db.Decimal(15, 2)
  incentives  Decimal  @default(0) @db.Decimal(15, 2)
  advances    Decimal  @default(0) @db.Decimal(15, 2)
  deductions  Decimal  @default(0) @db.Decimal(15, 2)
  netSalary   Decimal  @db.Decimal(15, 2)
  status      String   @default("GENERATED") // GENERATED, PAID
  generatedAt DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("salary_slips")
}

model StaffAdvance {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  amount       Decimal   @db.Decimal(15, 2)
  paidDate     DateTime
  recoveryDate DateTime?
  status       String    @default("PENDING") // PENDING, RECOVERED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("staff_advances")
}

// --- RETURN MANAGEMENT MODULE ---
model SalesReturn {
  id                String            @id @default(cuid())
  companyId         String
  businessPartnerId String
  originalInvoiceId String?
  returnNumber      String
  date              DateTime          @default(now())
  reason            String            @db.Text
  returnType        ReturnType        @default(CREDIT_NOTE)
  status            ReturnStatus      @default(DRAFT)
  subTotal          Decimal           @default(0) @db.Decimal(15, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(15, 2)
  cgstAmount        Decimal           @default(0) @db.Decimal(15, 2)
  sgstAmount        Decimal           @default(0) @db.Decimal(15, 2)
  igstAmount        Decimal           @default(0) @db.Decimal(15, 2)
  cessAmount        Decimal           @default(0) @db.Decimal(15, 2)
  totalTaxAmount    Decimal           @default(0) @db.Decimal(15, 2)
  grandTotal        Decimal           @default(0) @db.Decimal(15, 2)
  remarks           String?           @db.Text
  createdById       String
  approvedById      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner   BusinessPartner   @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  originalInvoice   Invoice?          @relation(fields: [originalInvoiceId], references: [id])
  items             SalesReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, businessPartnerId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String      @id @default(cuid())
  salesReturnId String
  productId     String?
  description   String      @db.Text
  qty           Decimal     @db.Decimal(15, 3)
  rate          Decimal     @db.Decimal(15, 2)
  taxPercent    Decimal     @db.Decimal(5, 2)
  taxAmount     Decimal     @db.Decimal(15, 2)
  cgstAmount    Decimal     @default(0) @db.Decimal(15, 2)
  sgstAmount    Decimal     @default(0) @db.Decimal(15, 2)
  igstAmount    Decimal     @default(0) @db.Decimal(15, 2)
  cessAmount    Decimal     @default(0) @db.Decimal(15, 2)
  total         Decimal     @db.Decimal(15, 2)
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product       Product?    @relation(fields: [productId], references: [id])

  @@index([salesReturnId])
  @@map("sales_return_items")
}

model PurchaseReturn {
  id                 String               @id @default(cuid())
  companyId          String
  businessPartnerId  String
  originalPurchaseId String?
  returnNumber       String
  date               DateTime             @default(now())
  reason             String               @db.Text
  returnType         ReturnType           @default(DEBIT_NOTE)
  status             ReturnStatus         @default(DRAFT)
  subTotal           Decimal              @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal              @default(0) @db.Decimal(15, 2)
  cgstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  sgstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  igstAmount         Decimal              @default(0) @db.Decimal(15, 2)
  cessAmount         Decimal              @default(0) @db.Decimal(15, 2)
  totalTaxAmount     Decimal              @default(0) @db.Decimal(15, 2)
  grandTotal         Decimal              @default(0) @db.Decimal(15, 2)
  remarks            String?              @db.Text
  createdById        String
  approvedById       String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner    BusinessPartner      @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  originalPurchase   Purchase?            @relation(fields: [originalPurchaseId], references: [id])
  items              PurchaseReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, businessPartnerId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  productId        String?
  description      String         @db.Text
  qty              Decimal        @db.Decimal(15, 3)
  rate             Decimal        @db.Decimal(15, 2)
  taxPercent       Decimal        @db.Decimal(5, 2)
  taxAmount        Decimal        @db.Decimal(15, 2)
  cgstAmount       Decimal        @default(0) @db.Decimal(15, 2)
  sgstAmount       Decimal        @default(0) @db.Decimal(15, 2)
  igstAmount       Decimal        @default(0) @db.Decimal(15, 2)
  cessAmount       Decimal        @default(0) @db.Decimal(15, 2)
  total            Decimal        @db.Decimal(15, 2)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product          Product?       @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model RefundTransaction {
  id              String       @id @default(cuid())
  companyId       String
  referenceId     String // ID of SalesReturn or PurchaseReturn
  referenceType   String // 'SALES_RETURN' or 'PURCHASE_RETURN'
  amount          Decimal      @db.Decimal(15, 2)
  refundMethod    RefundMethod @default(BANK_TRANSFER)
  transactionDate DateTime     @default(now())
  remarks         String?      @db.Text
  createdById     String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, referenceId])
  @@map("refund_transactions")
}

// --- NEW ENUMS ---
enum BusinessType {
  TRADING
  RETAIL
  WHOLESALE
  MANUFACTURING
  SERVICE
  MIXED
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED
  CONSUMABLE
  SERVICE
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- WAREHOUSE ---
model Warehouse {
  id        String            @id @default(cuid())
  companyId String
  name      String
  location  String?
  isActive  Boolean           @default(true)
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks    Stock[]
  batches   InventoryBatch[]
  serials   InventorySerial[]

  @@unique([companyId, name])
  @@map("warehouses")
}

// --- MANUFACTURING ---
model BillOfMaterial {
  id          String            @id @default(cuid())
  companyId   String
  productId   String
  name        String
  totalCost   Decimal           @default(0) @db.Decimal(15, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])
  items       BOMItem[]
  productions ProductionOrder[]

  @@unique([companyId, productId])
  @@map("bill_of_materials")
}

model BOMItem {
  id            String         @id @default(cuid())
  bomId         String
  rawMaterialId String
  qty           Decimal        @db.Decimal(15, 3)
  cost          Decimal        @db.Decimal(15, 2)
  bom           BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial   Product        @relation(fields: [rawMaterialId], references: [id])

  @@map("bom_items")
}

model ProductionOrder {
  id          String           @id @default(cuid())
  companyId   String
  bomId       String
  orderNo     String
  status      ProductionStatus @default(PLANNED)
  plannedQty  Decimal          @db.Decimal(15, 3)
  producedQty Decimal          @default(0) @db.Decimal(15, 3)
  rejectedQty Decimal          @default(0) @db.Decimal(15, 3)
  startDate   DateTime
  endDate     DateTime?
  totalCost   Decimal          @default(0) @db.Decimal(15, 2)
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom         BillOfMaterial   @relation(fields: [bomId], references: [id])

  @@unique([companyId, orderNo])
  @@map("production_orders")
}

// --- ADVANCED HRMS ---
model Shift {
  id        String     @id @default(cuid())
  companyId String
  name      String
  startTime String // e.g. "09:00"
  endTime   String // e.g. "18:00"
  graceTime Int        @default(15) // minutes
  createdAt DateTime   @default(now())
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@map("shifts")
}

model EmployeeLoan {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  amount          Decimal  @db.Decimal(15, 2)
  interestRate    Decimal  @default(0) @db.Decimal(5, 2)
  termMonths      Int
  emiAmount       Decimal  @db.Decimal(15, 2)
  remainingAmount Decimal  @db.Decimal(15, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("employee_loans")
}

// --- POS & SALES ORDERS ---
// --- MIGRATION & IMPORT ---
model ImportLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  module      String // Customers, Products, Invoices
  fileName    String
  fileType    String // CSV, XLSX, JSON
  status      String // PENDING, IN_PROGRESS, COMPLETED, FAILED, ROLLED_BACK
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errors      Json? // Array of error details
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("import_logs")
}

// --- OTHER INCOME / SERVICE INCOME ---
enum IncomeType {
  SERVICE
  RENTAL
  COMMISSION
  INTEREST
  MISC
  OTHER
}

model IncomeCategory {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  description String?       @db.Text
  accountId   String // GL account for posting (Service Revenue, Other Income, etc.)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account     Account       @relation(fields: [accountId], references: [id])
  incomes     OtherIncome[]

  @@unique([companyId, name])
  @@map("income_categories")
}

model OtherIncome {
  id                String           @id @default(cuid())
  companyId         String
  categoryId        String
  businessPartnerId String?
  branchId          String?
  department        String?
  employeeId        String?
  incomeNo          String
  date              DateTime
  incomeType        IncomeType       @default(SERVICE)
  walkInCustomer    String?
  description       String?          @db.Text
  reference         String?
  taxMode           TaxMode          @default(CGST_SGST)
  subTotal          Decimal          @default(0) @db.Decimal(15, 2)
  taxTotal          Decimal          @default(0) @db.Decimal(15, 2)
  cgstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  sgstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  igstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  cessAmount        Decimal          @default(0) @db.Decimal(15, 2)
  discount          Decimal          @default(0) @db.Decimal(15, 2)
  freight           Decimal          @default(0) @db.Decimal(15, 2)
  grandTotal        Decimal          @default(0) @db.Decimal(15, 2)
  status            DocumentStatus   @default(DRAFT)
  paymentStatus     String           @default("UNPAID") // PAID, UNPAID, PARTIAL
  paymentMethod     PaymentMethod?
  bankAccountId     String?
  notes             String?          @db.Text
  attachments       Json? // Simple array of URLs for now
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          IncomeCategory   @relation(fields: [categoryId], references: [id])
  businessPartner   BusinessPartner? @relation(fields: [businessPartnerId], references: [id])
  bankAccount       BankAccount?     @relation(fields: [bankAccountId], references: [id])
  branch            Branch?          @relation(fields: [branchId], references: [id])
  employee          Employee?        @relation(fields: [employeeId], references: [id])

  @@unique([companyId, incomeNo])
  @@index([companyId, categoryId])
  @@index([companyId, deletedAt])
  @@map("other_incomes")
}

// --- BACKUP & DISASTER RECOVERY ---
enum BackupOperation {
  BACKUP
  RESTORE
  EXPORT
  IMPORT
}

enum SystemBackupType {
  FULL
  INCREMENTAL
  MODULE
  TRANSACTIONS
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model BackupJob {
  id             String           @id @default(cuid())
  companyId      String? // Null means it's a Platform/Super Admin backup
  createdById    String
  name           String
  operation      BackupOperation
  type           SystemBackupType
  status         JobStatus
  progress       Int              @default(0) // 0 to 100
  sizeBytes      BigInt?
  durationMs     Int?
  checksum       String?
  fileUrl        String?
  encryptionMeta Json?
  errorLog       String?          @db.Text
  targetModules  Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User             @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("backup_jobs")
}

model BackupSchedule {
  id             String            @id @default(cuid())
  companyId      String?
  createdById    String
  frequency      ScheduleFrequency
  cronExpression String?
  retentionDays  Int               @default(30)
  lastRun        DateTime?
  nextRun        DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User              @relation(fields: [createdById], references: [id])

  @@index([companyId])
  @@map("backup_schedules")
}

model BackupAuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String
  action     String
  targetName String?
  ipAddress  String?
  userAgent  String?
  device     String?
  success    Boolean
  details    Json?
  createdAt  DateTime @default(now())
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("backup_audit_logs")
}

model Receipt {
  id                String              @id @default(cuid())
  companyId         String
  receiptNo         String
  date              DateTime
  businessPartnerId String
  accountId         String
  paymentMethod     String
  amount            Decimal             @db.Decimal(15, 2)
  referenceNo       String?
  chequeNo          String?
  transactionId     String?
  clearanceDate     DateTime?
  bankCharges       Decimal             @default(0) @db.Decimal(15, 2)
  cashier           String?
  notes             String?             @db.Text
  currency          String              @default("INR")
  exchangeRate      Decimal             @default(1.0) @db.Decimal(10, 4)
  receivedById      String
  status            String              @default("COMPLETED") // DRAFT, COMPLETED, VOID
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner   BusinessPartner     @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  account           Account             @relation(fields: [accountId], references: [id])
  receivedBy        User                @relation(fields: [receivedById], references: [id])
  allocations       ReceiptAllocation[]
  attachments       ReceiptAttachment[]
  audits            ReceiptAudit[]

  @@unique([companyId, receiptNo])
  @@index([companyId, date])
  @@index([companyId, deletedAt])
  @@map("receipts")
}

model ReceiptAllocation {
  id        String   @id @default(cuid())
  receiptId String
  invoiceId String
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([invoiceId])
  @@map("receipt_allocations")
}

model ReceiptAttachment {
  id        String   @id @default(cuid())
  receiptId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String?
  createdAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_attachments")
}

model ReceiptAudit {
  id        String   @id @default(cuid())
  receiptId String
  userId    String
  action    String // CREATE, UPDATE, DELETE, PRINT, EMAIL, VOID
  details   Json?
  createdAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("receipt_audits")
}

model SalesOrder {
  id                String           @id @default(cuid())
  companyId         String
  businessPartnerId String
  orderNo           String
  taxMode           TaxMode          @default(CGST_SGST)
  placeOfSupply     String?
  companyStateCode  String?
  customerStateCode String?
  billingAddress    String?          @db.Text
  shippingAddress   String?          @db.Text
  date              DateTime
  status            DocumentStatus   @default(DRAFT)
  subTotal          Decimal          @default(0) @db.Decimal(15, 2)
  taxTotal          Decimal          @default(0) @db.Decimal(15, 2)
  cgstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  sgstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  igstAmount        Decimal          @default(0) @db.Decimal(15, 2)
  cessAmount        Decimal          @default(0) @db.Decimal(15, 2)
  totalTaxAmount    Decimal          @default(0) @db.Decimal(15, 2)
  grandTotal        Decimal          @default(0) @db.Decimal(15, 2)
  gstBreakup        Json?
  deletedAt         DateTime?
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner   BusinessPartner  @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  items             SalesOrderItem[]

  @@unique([companyId, orderNo])
  @@index([companyId, businessPartnerId])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  productId   String?
  description String      @db.Text
  qty         Decimal     @db.Decimal(15, 3)
  rate        Decimal     @db.Decimal(15, 2)
  taxPercent  Decimal     @db.Decimal(5, 2)
  taxAmount   Decimal     @db.Decimal(15, 2)
  cgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  sgstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  igstAmount  Decimal     @default(0) @db.Decimal(15, 2)
  cessAmount  Decimal     @default(0) @db.Decimal(15, 2)
  taxCategory TaxCategory @default(TAXABLE)
  total       Decimal     @db.Decimal(15, 2)
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sales_order_items")
}

// --- PHASE 5: ADVANCED INVENTORY ---
model InventoryBatch {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String
  batchNo     String
  mfgDate     DateTime?
  expDate     DateTime?
  qty         Decimal   @default(0) @db.Decimal(15, 3)
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId, batchNo])
  @@index([companyId, warehouseId])
  @@map("inventory_batches")
}

model InventorySerial {
  id          String    @id @default(cuid())
  companyId   String
  productId   String
  warehouseId String
  serialNo    String
  status      String    @default("AVAILABLE") // AVAILABLE, SOLD, RESERVED
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId, serialNo])
  @@index([companyId, warehouseId])
  @@map("inventory_serials")
}

// --- PHASE 6: BANKING RECONCILIATION ---
model BankStatement {
  id             String              @id @default(cuid())
  companyId      String
  bankAccountId  String
  statementDate  DateTime
  openingBalance Decimal             @default(0) @db.Decimal(15, 2)
  closingBalance Decimal             @default(0) @db.Decimal(15, 2)
  status         String              @default("DRAFT") // DRAFT, RECONCILED
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines          BankStatementLine[]

  @@index([companyId, bankAccountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id                   String           @id @default(cuid())
  statementId          String
  date                 DateTime
  description          String           @db.Text
  amount               Decimal          @db.Decimal(15, 2)
  status               String           @default("UNMATCHED") // UNMATCHED, MATCHED, IGNORED
  matchedTransactionId String?          @unique
  statement            BankStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedTransaction   BankTransaction? @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)

  @@index([statementId])
  @@map("bank_statement_lines")
}

// --- PHASE 7: FIXED ASSETS & PROJECTS ---
model FixedAsset {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?  @db.Text
  assetType        String   @default("EQUIPMENT") // EQUIPMENT, VEHICLE, FURNITURE, IT
  purchasePrice    Decimal  @db.Decimal(15, 2)
  purchaseDate     DateTime
  depreciationRate Decimal  @default(0) @db.Decimal(5, 2)
  currentValue     Decimal  @db.Decimal(15, 2)
  status           String   @default("ACTIVE") // ACTIVE, DEPRECIATED, SOLD
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("fixed_assets")
}

model Project {
  id          String           @id @default(cuid())
  companyId   String
  customerId  String?
  name        String
  description String?          @db.Text
  startDate   DateTime
  endDate     DateTime?
  status      String           @default("PLANNING") // PLANNING, IN_PROGRESS, COMPLETED, ON_HOLD
  budget      Decimal          @default(0) @db.Decimal(15, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    BusinessPartner? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId, customerId])
  @@map("projects")
}
