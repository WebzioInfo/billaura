  company Company? @relation("CompanyPlatformLogs", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("platform_activity_logs")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model ApiKey {
  id        String    @id @default(cuid())
  companyId String
  name      String
  key       String    @unique
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(cuid())
  companyId String
  url       String
  event     String // e.g. "invoice.created"
  isActive  Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("webhooks")
}

model DocumentTemplate {
  id          String  @id @default(cuid())
  companyId   String
  type        String // INVOICE, QUOTATION
  htmlContent String  @db.Text
  isDefault   Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("document_templates")
}

model GSTReport {
  id        String   @id @default(cuid())
  companyId String
  month     Int
  year      Int
  type      String // GSTR-1, GSTR-3B
  data      Json
  status    String // GENERATED, FILED
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year, type])
  @@map("gst_reports")
}

model ScheduledTask {
  id          String     @id @default(cuid())
  companyId   String
  type        String // RECURRING_INVOICE, REMINDER
  payload     Json
  status      TaskStatus @default(PENDING)
  runAt       DateTime
  completedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@map("scheduled_tasks")
}

// --- PAYROLL MODULE ---
model Department {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

model Designation {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@map("designations")
}

model Employee {
  id            String    @id @default(cuid())
  companyId     String
  employeeCode  String
  name          String
  photo         String?   @db.Text
  mobile        String?
  email         String?
  address       String?   @db.Text
  dateOfBirth   DateTime?
  gender        String?
  joiningDate   DateTime?
  departmentId  String?
  designationId String?
  shiftId       String?
  employeeType  String    @default("PERMANENT")

  salaryType  SalaryType @default(MONTHLY)
  basicSalary Decimal    @default(0) @db.Decimal(15, 2)
  allowances  Json? // Store structured JSON array of { name, amount }

  bankDetails   Json? // Store { accountName, accountNumber, ifsc, bankName }
  aadhaarNumber String?
  panNumber     String?

  status             String  @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED, TERMINATED
  reportingManagerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department?  @relation(fields: [departmentId], references: [id])
  designation      Designation? @relation(fields: [designationId], references: [id])
  reportingManager Employee?    @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  reportees        Employee[]   @relation("ReportingManager")
  shift            Shift?       @relation(fields: [shiftId], references: [id])

  attendances       Attendance[]
  leaveApplications LeaveApplication[]
  salarySlips       SalarySlip[]
  advances          StaffAdvance[]
  loans             EmployeeLoan[]

  @@unique([companyId, employeeCode])
  @@map("employees")
}

model Attendance {
  id         String         @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime
  type       AttendanceType
  notes      String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model LeaveApplication {
  id         String      @id @default(cuid())
  companyId  String
  employeeId String
  type       String // CASUAL, SICK, PAID, EMERGENCY
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  reason     String?     @db.Text
  approvedBy String?
  createdAt  DateTime    @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("leave_applications")
}

model SalarySlip {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal  @db.Decimal(15, 2)
  allowances  Decimal  @db.Decimal(15, 2)
  bonus       Decimal  @default(0) @db.Decimal(15, 2)
  incentives  Decimal  @default(0) @db.Decimal(15, 2)
  advances    Decimal  @default(0) @db.Decimal(15, 2)
  deductions  Decimal  @default(0) @db.Decimal(15, 2)
  netSalary   Decimal  @db.Decimal(15, 2)
  status      String   @default("GENERATED") // GENERATED, PAID
  generatedAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("salary_slips")
}

model StaffAdvance {
  id           String    @id @default(cuid())
  companyId    String
  employeeId   String
  amount       Decimal   @db.Decimal(15, 2)
  paidDate     DateTime
  recoveryDate DateTime?
  status       String    @default("PENDING") // PENDING, RECOVERED
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("staff_advances")
}

// --- RETURN MANAGEMENT MODULE ---

model SalesReturn {
  id                String       @id @default(cuid())
  companyId         String
  businessPartnerId String
  originalInvoiceId String?
  returnNumber      String
  date              DateTime     @default(now())
  reason            String       @db.Text
  returnType        ReturnType   @default(CREDIT_NOTE)
  status            ReturnStatus @default(DRAFT)

  subTotal       Decimal @default(0) @db.Decimal(15, 2)
  taxTotal       Decimal @default(0) @db.Decimal(15, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(15, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(15, 2)
  igstAmount     Decimal @default(0) @db.Decimal(15, 2)
  cessAmount     Decimal @default(0) @db.Decimal(15, 2)
  totalTaxAmount Decimal @default(0) @db.Decimal(15, 2)
  grandTotal     Decimal @default(0) @db.Decimal(15, 2)

  remarks      String? @db.Text
  createdById  String
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner   @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  originalInvoice Invoice?          @relation(fields: [originalInvoiceId], references: [id])
  items           SalesReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, businessPartnerId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  productId     String?
  description   String  @db.Text
  qty           Decimal @db.Decimal(15, 3)
  rate          Decimal @db.Decimal(15, 2)
  taxPercent    Decimal @db.Decimal(5, 2)
  taxAmount     Decimal @db.Decimal(15, 2)
  cgstAmount    Decimal @default(0) @db.Decimal(15, 2)
  sgstAmount    Decimal @default(0) @db.Decimal(15, 2)
  igstAmount    Decimal @default(0) @db.Decimal(15, 2)
  cessAmount    Decimal @default(0) @db.Decimal(15, 2)
  total         Decimal @db.Decimal(15, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@index([salesReturnId])
  @@map("sales_return_items")
}

model PurchaseReturn {
  id                 String       @id @default(cuid())
  companyId          String
  businessPartnerId  String
  originalPurchaseId String?
  returnNumber       String
  date               DateTime     @default(now())
  reason             String       @db.Text
  returnType         ReturnType   @default(DEBIT_NOTE)
  status             ReturnStatus @default(DRAFT)

  subTotal       Decimal @default(0) @db.Decimal(15, 2)
  taxTotal       Decimal @default(0) @db.Decimal(15, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(15, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(15, 2)
  igstAmount     Decimal @default(0) @db.Decimal(15, 2)
  cessAmount     Decimal @default(0) @db.Decimal(15, 2)
  totalTaxAmount Decimal @default(0) @db.Decimal(15, 2)
  grandTotal     Decimal @default(0) @db.Decimal(15, 2)

  remarks      String? @db.Text
  createdById  String
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner  BusinessPartner      @relation(fields: [businessPartnerId], references: [id], onDelete: Cascade)
  originalPurchase Purchase?            @relation(fields: [originalPurchaseId], references: [id])
  items            PurchaseReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, businessPartnerId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  productId        String?
  description      String  @db.Text
  qty              Decimal @db.Decimal(15, 3)
  rate             Decimal @db.Decimal(15, 2)
  taxPercent       Decimal @db.Decimal(5, 2)
  taxAmount        Decimal @db.Decimal(15, 2)
  cgstAmount       Decimal @default(0) @db.Decimal(15, 2)
  sgstAmount       Decimal @default(0) @db.Decimal(15, 2)
  igstAmount       Decimal @default(0) @db.Decimal(15, 2)
  cessAmount       Decimal @default(0) @db.Decimal(15, 2)
  total            Decimal @db.Decimal(15, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model RefundTransaction {
  id              String       @id @default(cuid())
  companyId       String
  referenceId     String // ID of SalesReturn or PurchaseReturn
  referenceType   String // 'SALES_RETURN' or 'PURCHASE_RETURN'
  amount          Decimal      @db.Decimal(15, 2)
  refundMethod    RefundMethod @default(BANK_TRANSFER)
  transactionDate DateTime     @default(now())
  remarks         String?      @db.Text
  createdById     String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, referenceId])
  @@map("refund_transactions")
}

// --- NEW ENUMS ---
enum BusinessType {
  TRADING
  RETAIL
  WHOLESALE
  MANUFACTURING
  SERVICE
  MIXED
}

enum ItemType {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED
  CONSUMABLE
  SERVICE
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- WAREHOUSE ---
model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  name      String
  location  String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks  Stock[]

  @@unique([companyId, name])
  @@map("warehouses")
}

// --- MANUFACTURING ---
model BillOfMaterial {
  id        String   @id @default(cuid())
  companyId String
  productId String
  name      String
  totalCost Decimal  @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])
  items       BOMItem[]
  productions ProductionOrder[]

  @@unique([companyId, productId])
  @@map("bill_of_materials")
}

model BOMItem {
  id            String  @id @default(cuid())
  bomId         String
  rawMaterialId String
  qty           Decimal @db.Decimal(15, 3)
  cost          Decimal @db.Decimal(15, 2)

  bom         BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial Product        @relation(fields: [rawMaterialId], references: [id])

  @@map("bom_items")
}

model ProductionOrder {
  id          String           @id @default(cuid())
  companyId   String
  bomId       String
  orderNo     String
  status      ProductionStatus @default(PLANNED)
  plannedQty  Decimal          @db.Decimal(15, 3)
  producedQty Decimal          @default(0) @db.Decimal(15, 3)
  rejectedQty Decimal          @default(0) @db.Decimal(15, 3)
  startDate   DateTime
  endDate     DateTime?
  totalCost   Decimal          @default(0) @db.Decimal(15, 2)
  createdAt   DateTime         @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom     BillOfMaterial @relation(fields: [bomId], references: [id])

  @@unique([companyId, orderNo])
  @@map("production_orders")
}

// --- ADVANCED HRMS ---
model Shift {
  id        String   @id @default(cuid())
  companyId String
  name      String
  startTime String // e.g. "09:00"
  endTime   String // e.g. "18:00"
  graceTime Int      @default(15) // minutes
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@map("shifts")
}

model EmployeeLoan {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  amount          Decimal  @db.Decimal(15, 2)
  interestRate    Decimal  @default(0) @db.Decimal(5, 2)
  termMonths      Int
  emiAmount       Decimal  @db.Decimal(15, 2)
  remainingAmount Decimal  @db.Decimal(15, 2)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@map("employee_loans")
}

// --- POS & SALES ORDERS ---
model SalesOrder {
  id                String         @id @default(cuid())
  companyId         String
  businessPartnerId String
  orderNo           String
  date              DateTime
  status            DocumentStatus @default(DRAFT)
  grandTotal        Decimal        @default(0) @db.Decimal(15, 2)

  billingAddress  String? @db.Text
  shippingAddress String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  businessPartner BusinessPartner @relation(fields: [businessPartnerId], references: [id])

  @@unique([companyId, orderNo])
  @@map("sales_orders")
}

// --- MIGRATION & IMPORT ---
model ImportLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String
  module      String // Customers, Products, Invoices
  fileName    String
  fileType    String // CSV, XLSX, JSON
  status      String // PENDING, IN_PROGRESS, COMPLETED, FAILED, ROLLED_BACK
  totalRows   Int      @default(0)
  successRows Int      @default(0)
  failedRows  Int      @default(0)
  errors      Json? // Array of error details
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("import_logs")
}
