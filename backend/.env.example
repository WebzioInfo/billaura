# Server Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=api
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Database Configuration
# Format: mysql://user:password@host:port/database or postgresql://user:password@host:5432/database
DATABASE_URL="mysql://billaura_user:secret_password@localhost:3306/billaura_db"

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
COOKIE_DOMAIN="localhost"

# Email Configuration (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="billing@example.com"
SMTP_PASSWORD="smtp_secret_password"

# Media Storage (Cloudinary / S3)
CLOUDINARY_NAME="your_cloud_name"
CLOUDINARY_KEY="your_api_key"
CLOUDINARY_SECRET="your_api_secret"

# Debug & Safety Guards
DEBUG_API_LOGS=false
PROTECTED_DATABASE_HOSTS=""
PROTECTED_DATABASE_NAMES=""
